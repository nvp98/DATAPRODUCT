                    <!-- Modal Import -->
                    @* <div class="modal fade" id="myModalImportExcel" role="dialog" data-url='@Url.Action("ImportExcel", "CumTB")'></div>
                    <script type="text/javascript">
                        $('#btn-Import').click(function () {
                            var url = $('#myModalImportExcel').data('url');
                            $.get(url, function (data) {
                                $("#myModalImportExcel").html(data);
                                $("#ModalTitle").html("IMPORT DANH SÁCH CỤM THIẾT BỊ");
                                $("#myModalImportExcel").modal('show');
                            });
                        });
                    </script> *@

                    <!-- Bảng danh sách -->
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="table" cellpadding="0">
                                <thead style="font-size: 14px;">
                                    <tr>
                                        <th class="text-center" width="30px" style="background-color:#f7f7f7;">STT</th>
                                        <th class="text-center" width="200px" style="background-color:#f7f7f7;">Tên Cụm Thiết Bị</th>
                                        <th class="text-center" width="200px" style="background-color:#f7f7f7;">Xưởng</th>
                                        <th class="text-center" width="100px" style="background-color:#f7f7f7;">Trạng thái</th>
                                        <th class="text-center" width="130px" style="background-color:#f7f7f7;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int rowNo = 1;
                                    }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="text-center">@rowNo</td>
                                            <td style="font-size:14px;">@item.TenCumTB</td>
                                            <td style="font-size:14px;">
                                                @if (item.Xuong != null && item.Xuong.Any())
                                                {
                                                    @string.Join(", ", item.Xuong.Select(x => x.TenXuong))
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Chưa gán xưởng</span>
                                                }
                                            </td>

                                            <td class="text-center" style="font-size:14px;">
                                                @if (item.IsLock)
                                                {
                                                    <span style="color:red;">Đã khóa</span>
                                                }
                                                else
                                                {
                                                    <span style="color:green;">Hoạt động</span>
                                                }
                                            </td>

                                            <td class="text-center">
                                                @if (!item.IsLock)
                                                {
                                                    <a class="btn btn-primary btn-sm"
                                                       title="Khóa"
                                                       href="@Url.Action("ToggleLock", "CumTB", new { id = item.ID })"
                                                       onclick="return confirm('Bạn muốn khóa cụm thiết bị: @item.TenCumTB?')">
                                                        <i class="bi bi-lock-fill"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="btn btn-danger btn-sm"
                                                       title="Mở khóa"
                                                       href="@Url.Action("ToggleLock", "CumTB", new { id = item.ID })"
                                                       onclick="return confirm('Bạn muốn mở khóa cụm thiết bị: @item.TenCumTB?')">
                                                        <i class="bi bi-unlock-fill"></i>
                                                    </a>
                                                }

                                                <!-- Trong bảng: -->
                                                <a class="btn btn-primary btn-sm" href="javascript:void(0);" onclick="editCumTB(@item.ID)">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <div class="modal" id="myModalEdit_@item.ID" role="dialog"
                                                     data-url='@Url.Action("Edit", "CumTB", new { id = item.ID })'></div>
                                                <script type="text/javascript">
                                                    $("#btn-edit_@item.ID").click(function () {
                                                        var url = $('#myModalEdit_@item.ID').data('url');
                                                        $.get(url, function (data) {
                                                            $("#myModalEdit_@item.ID").html(data);
                                                            $("#ModalTitle").html("CHỈNH SỬA CỤM THIẾT BỊ");
                                                            $("#myModalEdit_@item.ID").modal('show');
                                                        });
                                                    });
                                                    $("#myModalEdit_@item.ID").on('hidden.bs.modal', function () {
                                                        $(this).find('.modal-body').html('');
                                                    });
                                                </script>
                                            </td>
                                        </tr>
                                        rowNo++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal chọn file -->
<div class="modal fade" id="importModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Import Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="file" id="excelFile" class="form-control" accept=".xlsx,.xls" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="btnSubmitImport" class="btn btn-primary btn-sm">Import</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#btn-Export').click(function () {
            exportExcelAjax();
        });

        function exportExcelAjax() {
            $.ajax({
                url: '/CumTB/ExportToExcel',
                type: 'GET',
                xhrFields: {
                    responseType: 'blob'
                },
                success: function (blob) {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'DanhSachCumThietBi.xlsx'; // ✅ FIX CỨNG
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    a.remove();
                },
                error: function () {
                    alert("Xuất Excel thất bại!");
                }
            });
        }

    </script>
}






<!-- Script tìm kiếm -->
<script type="text/javascript">
    $("#btn-search").on('click', function () {
        var search = $('#txtsearch').val();
        window.location.href = '@Url.Action("Index", "CumTB")?search=' + search;
    });
</script>

<!-- DataTable -->
<script>
    $(document).ready(function () {
        $('#table').DataTable({
            paging: true,
            searching: true,
            ordering: true,
            fixedHeader: true,
            scrollY: '70vh',
            scrollCollapse: true
        });
    });
</script>
