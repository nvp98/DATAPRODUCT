                                <i class="bi bi-plus-lg"></i> Thêm mới
                            </button>

                            <button id="btn-Export" class="btn btn-success">
                                <i class="bi bi-file-earmark-excel"></i> Xuất Excel
                            </button>
                        </div>
                    </div>

                    <!-- Nút thêm -->
                  @*   <div class="row">
                        <button id="btn-add" type="button" class="btn btn-primary w-auto float-right">
                            <i class="bi bi-plus-lg"></i> Thêm mới
                        </button>
                        <button id="btn-Export" class="btn btn-success btn-sm">
                            <i class="bi bi-file-earmark-excel"></i> Xuất Excel
                        </button>
                    </div> *@
                    <!-- Modal container -->
                    <div id="CumTBModalContainer"></div>

                    <script>
                        // 🟢 Mở modal tạo mới
                        $('#btn-add').click(function () {
                            $.get('@Url.Action("CumTBModal", "CumTB")', function (data) {
                                // 1️⃣ Đưa nội dung modal vào DOM
                                $('#CumTBModalContainer').html(data);

                                // 2️⃣ Gọi hiển thị modal sau khi HTML đã được render
                                const modalElement = new bootstrap.Modal(document.getElementById('CumTBModal'));
                                modalElement.show();
                            });
                        });

                        // 🟠 Mở modal chỉnh sửa
                        function editCumTB(id) {
                            $.get('@Url.Action("CumTBModal", "CumTB")?id=' + id, function (data) {
                                $('#CumTBModalContainer').html(data);
                                const modalElement = new bootstrap.Modal(document.getElementById('CumTBModal'));
                                modalElement.show();
                            });
                        }
                    </script>

                    <!-- Modal thêm mới -->
                    @* <div class="modal" id="myModal" role="dialog" data-url='@Url.Action("Create", "CumTB")'></div>
                    <script type="text/javascript">
                        $('#btn-add').click(function () {
                            var url = $('#myModal').data('url');
                            $.get(url, function (data) {
                                $("#myModal").html(data);
                                $("#ModalTitle").html("THÊM MỚI CỤM THIẾT BỊ");
                                $("#myModal").modal('show');
