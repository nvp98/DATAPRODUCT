@model Data_Product.Models.Tbl_NhatKy_CumTB

<script src="~/Content/assets/Chonse/chosen.jquery.js"></script>
<link href="~/Content/assets/Chonse/chosen.css" rel="stylesheet" />

<div class="modal fade" id="CumTBModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form asp-action="SaveCumTB" asp-controller="CumTB" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">@ViewBag.Title</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" asp-for="ID" />

                    <div class="form-group mb-3">
                        <label for="TenCumTB">Tên cụm thiết bị</label>
                        <input asp-for="TenCumTB" class="form-control" placeholder="Nhập tên cụm thiết bị" />
                    </div>
                    @if(ViewBag.Mode == "Create")
                    {
                        <label>Cụm Thêm</label>
                        <table class="table table-bordered" id="tableCumTB">
                            @*  <thead>
                            <tr>
                                <th>Tên cụm thiết bị</th>
                                <th style="width: 60px;">#</th>
                            </tr>
                        </thead> *@
                            <tbody>
                                <tr>
                                    <td>
                                        <input name="TenCumTBs[0]" class="form-control" placeholder="Nhập tên cụm thiết bị" />
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-success btn-sm btn-add-row">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    }

                    

                    <div class="form-group mb-3">
                        <label>Xưởng</label>
                        <select name="Xuong_ID" id="Xuong_ID" multiple class="form-control" asp-items="ViewBag.XuongList"></select>
                        <small class="text-muted">* Có thể tìm kiếm và chọn nhiều xưởng</small>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Lưu</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('#Xuong_ID').chosen({
            width: '100%'
        });
    });
</script>
<script>

    // 🟢 Thêm dòng mới
    $(document).on('click', '.btn-add-row', function () {
        var rowCount = $('#tableCumTB tbody tr').length;
        var newRow = `
            <tr>
                <td>
                    <input name="TenCumTBs[${rowCount}]" class="form-control" placeholder="Nhập tên cụm thiết bị" />
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-danger btn-sm btn-remove-row">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        `;
        $('#tableCumTB tbody').append(newRow);
    });

    // 🔴 Xóa dòng
    $(document).on('click', '.btn-remove-row', function () {
        $(this).closest('tr').remove();

        // Reindex lại các name input
        $('#tableCumTB tbody tr').each(function (i, tr) {
            $(tr).find('input[name^="TenCumTBs"]').attr('name', 'TenCumTBs[' + i + ']');
        });
    });
</script>

