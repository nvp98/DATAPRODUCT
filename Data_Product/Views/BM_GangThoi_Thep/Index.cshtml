    function buildPayloadFromRow($row) {

        const ID = $row.data('id') || null;

        let LyDo = null;

        // 1️⃣ Ưu tiên select2 (nếu có)
        const $selectLyDo = $row.find('.selectLyDo');

        if ($selectLyDo.length && $selectLyDo.data('select2')) {
            const lyDoData = $selectLyDo.select2('data');
            if (lyDoData && lyDoData.length > 0) {
                LyDo = lyDoData[0].text?.trim() || null;
            }
        }

        // 2️⃣ Fallback: input text LyDo (nếu có)
        if (!LyDo) {
            const txtLyDo = $row.find('.txt-lyDo').val();
            if (txtLyDo && txtLyDo.trim() !== '') {
                LyDo = txtLyDo.trim();
            }
        }

        return {
            ID: ID,
            ID_MeThoi: parseInt($row.find('.selectMeThoi').val()) || null,
            KLThungVaGang: getNumberValue($row.find('.txt-klThungVaGang').val()),
            KLThung: getNumberValue($row.find('.txt-klThung').val()),
            KLGang: getNumberValue($row.find('.txt-klGang').val()),
            SoThung: $row.find('.txt-soThung').val(),
            ThoiDiemRot: $row.find('.txt-thoiDiemRot').val(),
            LyDo: LyDo,
            IdLoThoi: parseInt($('#IDLoThoi').val()),
            Ca: parseInt($('#IDCaNhan').val()),
            NgaySanXuat: new Date($('#IDNgayNhan').val()).toISOString()
        };
    }

    function saveSplitRow($childRow, parentId, type) {
        // 🔴 VALIDATE MẺ CON TRƯỚC
        if (type === 'split') {
            if (!validateSplitChildRow($childRow)) {
                return;
            }
        }
        const $parentRow = $('#IDtbThungThepHRC1AT')
            .find(`tr[data-id="${parentId}"]`);

        if ($parentRow.length === 0) {
            alert('Không tìm thấy mẻ cha.');
            return;
        }
        // 1️⃣ Build payload CHA
        const parentPayload = buildPayloadFromRow($parentRow);
        parentPayload.LoaiMe = 1; // mẻ cha
        // 2️⃣ Save CHA
        $.ajax({
            url: '/BM_16_LuyenThepHRC1/UpsertMeGangVaoLo',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(parentPayload),
            success: function () {
                // 3️⃣ Build payload CON
                const childPayload = buildPayloadFromRow($childRow);
                childPayload.ParentID = parentId;
                childPayload.IsMeTach = type === 'split';
                childPayload.LoaiMe = 2; // mẻ con
                // 4️⃣ Save CON
                console.log(childPayload)
                $.ajax({
                    url: '/BM_16_LuyenThepHRC1/UpsertMeGangVaoLo',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(childPayload),
                    success: function () {
                        $parentRow.find('.btn-split-row')
                            .prop('disabled', false)
                            .removeClass('disabled');

                        alert('Đã lưu');
                        LoadDanhSachThungThepHRC1AT();
                    },
                    error: function (xhr) {
                        alert('Lỗi lưu mẻ: ' + xhr.responseText);
                    }
                });
            },
            error: function (xhr) {
                alert('Lỗi lưu mẻ: ' + xhr.responseText);
            }
        });
    }

    function validateSplitChildRow($row) {

        const klTVG = parseFloat(
            $row.find('.txt-klThungVaGang').val()
        );

        const lyDo = $row.find('.selectLyDo').select2('data');

        if (isNaN(klTVG) || klTVG <= 0) {
            alert('Mẻ tách bắt buộc nhập KL Thùng + Gang.');
            $row.find('.txt-klThungVaGang').focus();
            return false;
        }

        if (!lyDo || lyDo.length === 0 || !lyDo[0].text?.trim()) {
            alert('Mẻ tách bắt buộc chọn Lý do.');
            $row.find('.selectLyDo').select2('open');
            return false;
        }

        return true;
    }


    function saveSingleRow($row, loaiMe = null) {

        const ID = $row.data('id') || null;
        const isNew = $row.data('is-new') === true ;
        const type = $row.data('type') === "split";

        const ID_MeThoi = $row.find('.selectMeThoi').val();
        const ThoiDiemRot = $row.find('.txt-thoiDiemRot').val()?.trim();
        const SoThung = $row.find('.txt-soThung').val();
        const KLThungVaGang = $row.find('.txt-klThungVaGang').val();
        const KLThung = $row.find('.txt-klThung').val();
        const KLGang = $row.find('.txt-klGang').val();

        const lyDoData = $row.find('.selectLyDo').select2('data');

        let LyDo = null;

        if (lyDoData && lyDoData.length > 0) {
            LyDo = lyDoData[0].text?.trim();
        }

        const IdLoThoi = $('#IDLoThoi').val();
        const Ca = $('#IDCaNhan').val();
        const NgayNhan = $('#IDNgayNhan').val();

        // 🔴 VALIDATE – chỉ validate khi là mẻ mới
        if (!type) {
            if (!ID_MeThoi) return alert('Vui lòng chọn Mẻ thổi.');
            if (!ThoiDiemRot) return alert('Vui lòng nhập Thời điểm rót.');
            if (!SoThung) return alert('Vui lòng nhập Số thùng.');
            if (!KLThungVaGang) return alert('Vui lòng nhập KL Thùng + Gang.');
            if (!KLThung) return alert('Vui lòng nhập KL Thùng.');
            if (!KLGang) return alert('Vui lòng nhập KL Gang.');
            if (!NgayNhan || !Ca || !IdLoThoi)
                return alert('Vui lòng chọn Ngày sản xuất, Ca và Lò thổi.');
            if (!LyDo) return alert('Vui lòng nhập Lý do.');
        }

        const payload = {
            ID: ID,
            ID_MeThoi: ID_MeThoi ? parseInt(ID_MeThoi) : null,
            KLThungVaGang: getNumberValue(KLThungVaGang),
            KLThung: getNumberValue(KLThung),
            KLGang: getNumberValue(KLGang),
            SoThung: SoThung,
            ThoiDiemRot: ThoiDiemRot,
            LyDo: LyDo,
            IdLoThoi: parseInt(IdLoThoi),
            Ca: parseInt(Ca),
            NgaySanXuat: new Date(NgayNhan).toISOString(),
            ParentID: $row.data('parent-id') || null,
            LoaiMe: loaiMe
        };

        $.ajax({
            url: '/BM_16_LuyenThepHRC1/UpsertMeGangVaoLo',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {

                // 🔒 khóa input
                $row.find('input, select').prop('disabled', true);

                // 🔄 toggle nút
                $row.find('.btn-save-row, .btn-cancel-row').addClass('d-none');
                $row.find('.btn-edit-row').removeClass('d-none');

                alert(res?.message || 'Đã lưu.');

                // 🔄 reload table
                LoadDanhSachThungThepHRC1AT();
            },
            error: function (xhr) {
                alert('Lỗi lưu: ' + (xhr.responseText || 'Không rõ'));
            }
        });
    }


