        const $editRow = $(buildEditRowHtml(item));
        $row.replaceWith($editRow);

        initSelectMeThoiInTable();   // đọc selected-id + selected-ma
        initSelectLyDo($editRow); 
        applyColumnVisibility();

        // 🔥 NẾU ĐÂY LÀ MẺ CON → bind lại hành vi split
        if (item.parentID) {
            const $parentRow = $editRow.prevAll('tr')
                .filter(function () {
                    return $(this).data('id') == item.parentID;
                })
                .first();

            if ($parentRow.length) {
                bindSplitChildBehavior($editRow, $parentRow, {inheritKlThungFromParent: false});
            }
        }
    });




    $(document).on('click', '.btn-cancel-row', function () {
        LoadDanhSachThungThepHRC1AT();
    });

    // $(document).on('click', '.btn-delete-row', function () {
    //     $(this).closest('tr').remove();
    // });
    $(document).on('click', '.btn-delete-row', function () {

        const $row = $(this).closest('tr');

        // Chỉ xử lý cho dòng tách
        if ($row.data('type') !== 'split') {
            $row.remove();
            return;
        }

        const parentId = $row.data('parent-id');
        if (!parentId) {
            $row.remove();
            return;
        }

        // 🔎 Tìm lại dòng CHA
        const $parentRow = $('#IDtbThungThepHRC1AT')
            .find(`tr[data-id="${parentId}"]`);

        if ($parentRow.length) {

            // 🔁 RESTORE dữ liệu CHA
            $parentRow.find('.txt-klThungVaGang')
                .val($row.data('parent-kltvg'))
                .trigger('input');

            $parentRow.find('.txt-klThung')
                .val($row.data('parent-klthung'))
                .trigger('input');

            $parentRow.find('.txt-klGang')
                .val($row.data('parent-klgang'));

            // Enable lại nút tách
            $parentRow.find('.btn-split-row')
                .prop('disabled', false)
                .removeClass('disabled');
        }

        // ❌ Xóa dòng CON
        $row.remove();
    });


    function initSelectLyDo($row) {
        const $select = $row.find('.selectLyDo');

        if (!$select.length) return;

        // destroy nếu đã init
        if ($select.hasClass('select2-hidden-accessible')) {
            $select.select2('destroy');
        }

        const selectedText = $select.data('lydo');   // TEXT lý do
        // ============================
        // 🔑 APPEND OPTION ĐÃ CHỌN (EDIT)
        // ============================
        if (selectedText) {
            let exists = false;

            $select.find('option').each(function () {
                if ($(this).text() === selectedText) {
                    exists = true;
                    $(this).prop('selected', true);
                }
            });

            if (!exists) {
                const value =  selectedText; 
                const option = new Option(selectedText, value, true, true);
                $select.append(option);
            }
        }
        $select.select2({
            placeholder: 'Chọn hoặc nhập lý do',
            width: '100%',
            tags: true,                  // 🔴 cho nhập tay
            minimumInputLength: 0,       // 🔴 CLICK LÀ LOAD
            allowClear: true,

            ajax: {
                url: '/LyDoXuLyMe/SearchAutoComplete',
                type: 'POST',
                contentType: 'application/json',
                delay: 300,

                data: function (params) {
                    return JSON.stringify({
                        PageNumber: 1,
                        PageSize: 20,
                        SearchText: params.term || "", 
                        TrangThai: true
                    });
                },

                processResults: function (res) {
                    return {
                        results: (res.data || []).map(x => ({
                            id: x.id,
                            text: x.lyDo
                        }))
                    };
                },

                cache: true
            },

            createTag: function (params) {
                const term = params.term?.trim();
                if (!term) return null;

                return {
                    id: term,        
                    text: term,
                    newTag: true
                };
            }
        });

        $select.on('click', function () {
            $(this).select2('open');
        });
    }

    function setDefaultTimeRangeAT() {

        const ngayNhanVal = $('#IDNgayNhan').val(); // yyyy-MM-dd
        if (!ngayNhanVal) return;

        const IDLoThoi = $('#IDLoThoi').val();
        if(!IDLoThoi) return;

        const ca = parseInt($('#IDCaNhan').val());
        if (![1, 2].includes(ca)) return;

        // ===============================
        // 1️⃣ XÁC ĐỊNH ĐẾN GIỜ (THEO CA)
        // ===============================
        let denNgay = new Date(ngayNhanVal + 'T00:00:00');

        if (ca === 1) {
            // Ca ngày: kết thúc lúc 20:00 cùng ngày
            denNgay.setHours(20, 0, 0, 0);
        } else if (ca === 2) {
            // Ca đêm: kết thúc lúc 08:00 ngày hôm sau
            denNgay.setDate(denNgay.getDate() + 1);
            denNgay.setHours(8, 0, 0, 0);
        }

        $('#DenNgayAT').val(formatDateTimeLocal(denNgay));

        // ===============================
        // 2️⃣ XÁC ĐỊNH TỪ GIỜ (ĐẦU CA - 2H)
        // ===============================
        let startOfShift = new Date(ngayNhanVal + 'T00:00:00');

        if (ca === 1) {
            // Ca ngày bắt đầu 08:00
            startOfShift.setHours(8, 0, 0, 0);
        } else if (ca === 2) {
            // Ca đêm bắt đầu 20:00
            startOfShift.setHours(20, 0, 0, 0);
        }

        // Trừ 2 tiếng
        startOfShift.setHours(startOfShift.getHours() - 2);

        $('#TuNgayAT').val(formatDateTimeLocal(startOfShift));

        
        LoadDanhSachThungThepHRC1AT();
    }


    function formatDateTimeLocal(date) {
        const pad = n => n.toString().padStart(2, '0');

        return date.getFullYear() + '-' +
            pad(date.getMonth() + 1) + '-' +
            pad(date.getDate()) + 'T' +
            pad(date.getHours()) + ':' +
            pad(date.getMinutes());
    }
    function formatDate_ddMMyyyy(dateVal) {
        if (!dateVal) return '';
        const d = new Date(dateVal);
        if (isNaN(d)) return '';

        const dd = String(d.getDate()).padStart(2, '0');
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const yyyy = d.getFullYear();

        return `${dd}-${mm}-${yyyy}`;
    }


    $(document).ready(function () {
        setDefaultTimeRangeAT();
        bindSelectMeThoiForTableHRC1AT();
    });

</script>