    <script type="text/javascript">
        let pendingPayload = null;
        let dataThungDaNhan = [];
        let selectedMaThung = null;
        let selectedMaThungHuy = null;
        let selectedMaThungHuyTmp = null;
        let isHidden = true;
        let isValidLuu = true;
        let resultChiaGang = null;
        let selectedThungsGlobal = [];

        // render card trạng thái
        function renderStatusCard(tinhTrang) {
            const statusMap = {
                1: { label: "Chưa xử lý", bgClass: "bg-chua-chuyen" },
                2: { label: "Chờ xử lý", bgClass: "bg-cho-xu-ly" },
                3: { label: "Đã Xử lý", bgClass: "bg-da-chuyen" },
                4: { label: "Đã nhận", bgClass: "bg-da-nhan" },
                5: { label: "Đã chốt", bgClass: "bg-da-chot" },
                6: { label: "Đã sử dụng", bgClass: "bg-da-chot"}
            };

            const { label, bgClass } = statusMap[tinhTrang] || {
                label: "Không rõ", bgClass: "bg-light"
            };

            return `
                <div class="status-card ${bgClass}">
                <span class="status-text small pt-2 ps-1"">
                        ${label}
                    </span>
                </div>
            `;
        }
    


    function renderTableXuLySoLieu(data) {
          const $tbody = $('#IDtbXuLySoLieu tbody');
          if (!$tbody.length) return;

          // cleanup
          $('.selectMeThoi').each(function () { if ($(this).data('select2')) $(this).select2('destroy'); });
          $tbody.empty();

          if (!Array.isArray(data) || data.length === 0) {
            $tbody.append(`<tr><td colspan="20" class="text-center text-muted" style="padding:20px;font-size:20px;font-weight:600;">Không tìm thấy dữ liệu</td></tr>`);
            safe(sumKLGangNhan); safe(sumKLGangThoi);
            return;
          }

          const phongBan = $("#IDPhongBan").val();
          const tenTaiKhoan = $('#IDTenTaiKhoan').val().trim();
          let stt = 1;
          const normKey = s => (s == null ? '' : String(s).trim().toUpperCase());

          const disabledHRC1 = phongBan === "HRC1" &&  tenTaiKhoan !== "HPDQ18461" ? 'disabled' : '';
          // ========== RENDER THEO THỨ TỰ SERVER ==========
          data.forEach(tg => {
            const isCopyTTG  = tg.isCopy === true || tg.isCopy === 'true';
            const hasCopyVal = tg.maThungTG_Copy && tg.maThungTG_Copy !== 'null';

            const thungs = Array.isArray(tg.danhSachThungGang) ? tg.danhSachThungGang : [];
            if (!thungs.length) return;


            // khóa nhóm TTG để merge (copy tách group với gốc)
            const ttgKey = hasCopyVal ? tg.maThungTG_Copy : (tg.maThungTG || '');
            const isNhap = tg.isNhap;

            thungs.forEach(thung => {
              const tinhTrangHTML = (typeof renderStatusCard === 'function') ? renderStatusCard(thung.iD_TrangThai) : (thung.iD_TrangThai ?? '');
              const disabled        = thung.iD_TrangThai === 5 ? 'disabled' : '';
              const disabledInputKL = thung.iD_TrangThai === 5 || phongBan === "HRC1" ? 'disabled' : '';
              const maChiaNorm = normKey(thung.maChiaGang);
              const isSaiChuyenDen = thung.isSaiChuyenDen;
              let row = `<tr data-ttgkey="${ttgKey}"
                             data-mathungtg="${tg.maThungTG || ''}"
                             data-mathunggang="${thung.maThungGang || ''}"
                             data-mathungthep="${thung.maThungThep || ''}"
                             data-id="${thung.id || ''}"
                             data-machia="${maChiaNorm}"`;
              if (hasCopyVal) row += ` data-mathungcopy="${tg.maThungTG_Copy}"`;
              row += ` data-copy="${isCopyTTG}">`;

              // STT
              row += `<td>${stt}</td>`;

              // Cột thông tin cơ bản
              row += `
                <td class="hide-col">
                  <input type="checkbox" class="cbx-chiaGang" style="display:${isCopyTTG ? 'none' : 'inline-block'}"
                         name="ChonThung" ${disabledHRC1} ${thung.iD_TrangThai == 5 || (thung.klGangChia !== null && thung.klGangChia > 0) || maChiaNorm ? "disabled readonly" : ""}/>
                </td>
                <td class="hide-col idGang">${thung.bkmiS_SoMe ?? ''}</td>
                <td class="hide-col maThungThep" data-mathungganggoc="${thung.maThungGang || ''}">${thung.maThungThep ?? ''}</td>
                <td>${thung.iD_LoCao ?? ''}</td>
                <td>${thung.bkmiS_ThungSo ?? ''}</td>
                <td>${tinhTrangHTML}</td>
              `;

              // 3 cột gộp theo maChia
              if (isCopyTTG) {
                row += `
                  <td class="col-nhietDo"><span></span></td>
                  <td class="col-vagang"><span></span></td>
                  <td class="col-thung"><span></span></td>
                  <td class="col-ganglong KLGangLong"><span></span></td>
                `;
              } else {
                row += `
                  <td class="col-nhietDo">
                    <input class="table_tbx nhietDo" type="number" min="0"
                           name="nhietDo" ${disabled} value="${thung.nhietDo ?? ''}"/>
                  </td>
                  <td class="col-vagang">
                    <input style="max-width: 75px" class="table_tbx KhoiLuongThungVaGangLong" type="number" min="0"
                           name="t_KLThungVaGang" ${disabled || disabledHRC1} value="${thung.t_KLThungVaGang ?? ''}"/>
                  </td>
                  <td class="col-thung">
                    <input class="table_tbx KhoiLuongThung" type="number" min="0"
                           name="t_KLThungChua" ${disabled || disabledHRC1} value="${thung.t_KLThungChua ?? ''}"/>
                  </td>
                  <td class="col-ganglong KLGangLong">${thung.t_KLGangLong ?? '0'}</td>
                `;
              }

              // KL gang chia (mỗi hàng)
              row += `<td class="hide-col KLGangChia" style="color:${isCopyTTG ? '' : (thung.klGangChia !== null ? 'red' : 'black')}">
                        ${isCopyTTG ? '' : (thung.klGangChia !== null ? thung.klGangChia : (thung.t_KLGangLong ?? ''))}
                      </td>`;
              row += `<td class="KLGangChiaCR" style="color:${(thung.isChiaCR ? 'red' : 'black')}">
                    ${isSaiChuyenDen ? 'sai' : thung.kL_GangChiaCR !== null ? thung.kL_GangChiaCR : (thung.g_KLGangLong ?? '')}
              </td>`;

              // CÁC CỘT CẤP TTG (render ở mọi hàng – lát nữa merge)
              const actionHtml = tg.isCopy
                ? `<button ${disabled} class="btn-item-action btn btn-danger btn-sm btn-XoaCopy" title="Xóa"><i class="bi bi-trash"></i></button>`
                : `<button ${disabled} class="btn-item-action btn btn-secondary btn-sm btn-Copy" title="copy"><i class="bi bi-copy"></i></button>`;

              row += `
                <td class="hrc2">${actionHtml}</td>
                <td class="col-ganglongtruockr">
                    ${((isNhap ?? true) && !isCopyTTG) ? `<input ${disabled} style="max-width: 75px" class="table_tbx KLThungVaGangTruocKR" type="number" min="0"
                         name="klThungVaGangTruocKR" value="${tg.klThungVaGangTruocKR ?? ''}"/>` : ''}
                </td>
                <td class="col-gangnhan tong_KL_GangNhan">${isCopyTTG ? '':tg.tong_KLGangNhan ?? 0}</td>
                <td class="col-sothungtg">${tg.soThungTG ?? ''}</td>

                <td class="col-thungvagangthoi">
                  <input style="max-width: 75px" ${disabledInputKL || disabledHRC1} class="table_tbx KLThungVaGangLongVaoLoThoi" type="number" min="0"
                         name="klThungVaGang_Thoi" value="${tg.klThungVaGang_Thoi ?? ''}"/>
                </td>
                <td class="col-thungthoi">
                  <input ${disabledInputKL || disabledHRC1} class="table_tbx KLThungVaoLoThoi" type="number" min="0"
                         name="klThung_Thoi" value="${tg.klThung_Thoi ?? ''}"/>
                </td>
                <td class="col-phe">
                  <input ${disabled} class="table_tbx KLPhe" type="number" min="0" name="kl_phe"
                         value="${tg.kL_phe ?? 0}" data-customized="false"/>
                </td>
                <td id="IDKLVaoLoThoi" class="col-gangthoi KLVaoLoThoi">${tg.klGang_Thoi ?? '0.00'}</td>

                <td class="col-methoi">
                  <select ${disabled || disabledHRC1} class="form-select selectMeThoi" data-selected-id="${tg.iD_MeThoi || ''}" data-selected-ma="${tg.maMeThoi || ''}">
                    <option value="">-- Mẻ thổi --</option>
                  </select>
                </td>
                <td class="col-giochonme">
                  
                    <input ${(disabled || (disabledHRC1 && tg.gioChonMe)) ? 'disabled' : ''}
                   class="table_tbx GioChonMe"
                   type="time"
                   name="GioChonMe"
                   min="00:00"
                   max="23:59"
                   value="${tg.gioChonMe ?? ''}"
                   style="max-width: 100px;">

                </td>
                <td class="col-klxikr hide-col">
                    <input readonly class="table_tbx KLXIKR" type="number" min="0" name="klxikr" style="color: ${thung.klXiKR < 0 ? 'red':''}"
                             value="${thung.klXiKR ?? ''}"/>
                </td>
                <td class="col-ghichu">
                  <textarea style="min-width: 130px; height: 30px;" ${disabled} class="table_tbx IDGhiChu" name="ghiChu" id="IDGhiChu">${tg.ghiChu ?? ''}</textarea>
                </td>
              `;

              row += `</tr>`;
              $tbody.append(row);
              stt++;
            });
          });

        // ========== MERGE SAU KHI RENDER ==========
        const TTG_COLS = ['td.hrc2','td.col-gangnhan','td.col-sothungtg','td.col-thungvagangthoi','td.col-thungthoi', 'td.col-ganglongtruockr',
          'td.col-phe','td.col-gangthoi','td.col-methoi','td.col-giochonme','td.col-ghichu', 'td.col-klxikr'
        ];
        const MACHIA_COLS = ['td.col-nhietDo','td.col-vagang','td.col-thung','td.col-ganglong'];

        // Thu thập ranges theo attr
        const $rows = $tbody.find('tr');

        // Gom range theo một thuộc tính
        function rangesByAttr(attr, requireNonEmpty=false) {
          const ranges=[]; let i=0;
          while(i<$rows.length){
            const key = ($rows.eq(i).data(attr)??'').toString();
            let j=i+1; while(j<$rows.length && (($rows.eq(j).data(attr)??'').toString()===key)) j++;
            const span=j-i; if(span>1 && (!requireNonEmpty || key)) ranges.push([i,j-1]); i=j;
          }
          return ranges;
        }

        // Gom range theo "kết hợp attr1|attr2" (để giới hạn merge trong từng TTG)
        function rangesByComposite(attr1, attr2) {
          const ranges=[]; let i=0;
          while(i<$rows.length){
            const k1 = ($rows.eq(i).data(attr1)??'').toString();
            const k2 = ($rows.eq(i).data(attr2)??'').toString();
            let j=i+1;
            while(
              j<$rows.length &&
              (($rows.eq(j).data(attr1)??'').toString()===k1) &&
              (($rows.eq(j).data(attr2)??'').toString()===k2)
            ) j++;
            const span=j-i; if(span>1 && k1) ranges.push([i,j-1]);
            i=j;
          }
          return ranges;
        }

        function applyMerge(ranges, selectors){
          ranges.forEach(([start,end])=>{
            const span=end-start+1; if(span<=1) return;
            selectors.forEach(sel=>{
              let $first=null;
              for(let r=start;r<=end;r++){
                const $c=$rows.eq(r).find(sel).first();
                if(!$c.length) continue;
                if($first==null) $first=$c; else $c.remove();
              }
              if($first) $first.attr('rowspan',span);
            });
          });
        }

        if (phongBan === 'HRC1') {
          // HRC1: GỘP HẾT các cột (TTG_COLS + 3 cột trước) theo cùng MaChia trên TOÀN BẢNG
          const rMaChiaAll = rangesByAttr('machia', true);
          applyMerge(rMaChiaAll, MACHIA_COLS.concat(TTG_COLS));
        } else {
          // HRC2: gộp 3 cột theo MaChia TRONG PHẠM VI từng TTG/TTG-copy
          const rMaChiaWithinTTG = rangesByComposite('machia','ttgkey');
          applyMerge(rMaChiaWithinTTG, MACHIA_COLS);

          // cột cấp TTG gộp theo từng TTG/TTG-copy (copy tách group với gốc)
          const rByTTG = rangesByAttr('ttgkey', true);
          applyMerge(rByTTG, TTG_COLS);
        }

        // ==== phụ trợ ====
        safe(initSelectMeThoiInTable);
        safe(sumKLGangNhan);
        safe(sumKLGangChia);
        safe(sumKLGangLong);
        safe(sumKLGangThoi);
        safe(applyColumnVisibility);

        function safe(fn){ if(typeof fn==='function') fn(); }
    }


        //render table Khu Vuc Nhan Thung
        function renderTableNhanThung(data) {
                
