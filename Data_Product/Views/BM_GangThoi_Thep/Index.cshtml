                        </button>
                        <button class="btn btn-sm btn-success btn-save-row d-none"
                                style="display:${canEdit ? 'inline-block' : 'none'}">
                            <i class="bi bi-check2"></i>
                        </button>

                        <button class="btn btn-sm btn-secondary btn-cancel-row d-none"
                                style="display:${canEdit ? 'inline-block' : 'none'}">
                            <i class="bi bi-x"></i>
                        </button>
                
                        
                    </td>
                `}
            </tr>
            `;

            $tbody.append(html);
        });
        applyColumnVisibility();
    }

