    function bindSplitChildBehavior($childRow, $parentRow, options = {}) {

        const {
            inheritKlThungFromParent = false  // 🔑 mặc định KHÔNG inherit
        } = options;

        // =========================
        // 1️⃣ Inherit KL thùng từ CHA (CHỈ KHI SPLIT)
        // =========================
        if (inheritKlThungFromParent) {
            const klThungCha =
                parseFloat($parentRow.data('parent-klthung')) ||
                parseFloat($parentRow.find('.txt-klThung').val()) || 0;

            $childRow.find('.txt-klThung')
                .val(klThungCha)
                .prop('readonly', true)
                .addClass('bg-light');
        }

        // =========================
        // 2️⃣ Khi sửa CON → đẩy ngược lên CHA
        // =========================
        $childRow.find('.txt-klThungVaGang').on('input', function () {

            const klTVG_Con = parseFloat($(this).val());
            if (isNaN(klTVG_Con)) return;

            // 🔁 ĐẨY NGƯỢC LÊN CHA
            const $txtKlThungCha = $parentRow.find('.txt-klThung');
            $txtKlThungCha.val(klTVG_Con);
            $txtKlThungCha.trigger('input');

            // 🔢 TÍNH KLGANG CON (nếu có klThung)
            const klThungCon = parseFloat(
                $childRow.find('.txt-klThung').val()
            );

            if (!isNaN(klThungCon)) {
                const klGangCon = klTVG_Con - klThungCon;
                $childRow.find('.txt-klGang').val(
                    klGangCon >= 0 ? klGangCon : ''
                );
            }
        });
    }

