    function formatDateDMY(dateStr) {
        if (!dateStr) return '';
        const d = new Date(dateStr);
        const dd = String(d.getDate()).padStart(2, '0');
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const yyyy = d.getFullYear();
        return `${dd}-${mm}-${yyyy}`;
    }

    function renderMoDalTPHHMeGang(data) {

        const modal = new bootstrap.Modal(
            document.getElementById('modalShowTPHHGang')
        );
        modal.show();

        const $tb = $('#tblTPHH tbody').empty();
        const $cur = $('#cr-current').empty();

        if (!data || !data.tphh) return;


        $cur.html(`
            <div class="row">
                <div class="col-md-4"><b>Lò cao:</b> ${data.iD_LoCao}</div>
                <div class="col-md-4"><b>Ngày:</b> ${formatDateDMY(data.ngayTao)}</div>
                <div class="col-md-4"><b>Ca:</b> ${data.g_Ca}</div>
            </div>
            <div class="row">
                <div class="col-md-4"><b>Số mẻ:</b> ${data.bkmiS_SoMe}</div>
                <div class="col-md-4"><b>Thùng số:</b> ${data.bkmiS_ThungSo}</div>
                <div class="col-md-4"><b>Giờ NM:</b> ${data.gio_NM}</div>
            </div>
        `);



        const t = data.tphh;

        const tr = $('<tr class="fw-semibold">');
        tr.append(`<td>${t.c?.toFixed(3) ?? ''}</td>`);
        tr.append(`<td>${t.si?.toFixed(3) ?? ''}</td>`);
        tr.append(`<td>${t.mn?.toFixed(3) ?? ''}</td>`);
        tr.append(`<td>${t.s?.toFixed(3) ?? ''}</td>`);
        tr.append(`<td>${t.p?.toFixed(3) ?? ''}</td>`);
        tr.append(`<td>${t.ti?.toFixed(3) ?? ''}</td>`);
        tr.append(`<td class="text-danger">${t.temp ?? ''}</td>`);

        $tb.append(tr);

    }

</script>

<script>
    var selectedThungMocNoiGlobal = null;
    let deleteMePayload = null;

    function LoadDanhSachThungThepHRC1AT(){
        $("#btn-ThemMoiHRC1").show();
        const NgayNhan = $('#IDNgayNhan').val() || null;
        const IDCaNhan = $('#IDCaNhan').val() || null;
        const IDLoThoi = $('#IDLoThoi').val() || null;
        const TuNgay = $('#TuNgayAT').val() || null;
        const DenNgay = $('#DenNgayAT').val() || null;
        const MeThoi = $('#MeThoiAT').val() || null;
        let TrangThaiAT = null;

        const trangThaiVal = $('#TrangThaiAT').val();

        if (trangThaiVal === "true") {
            TrangThaiAT = true;          // Đã sử dụng
        }
        else if (trangThaiVal === "false") {
            TrangThaiAT = false;         // Chưa sử dụng (IS NULL)
        }
 
        if(!NgayNhan){
            alert("Vui lòng chọn Ngày Nhận"); return;
        }
        if(!IDCaNhan ){
            alert("Vui lòng chọn Ca"); return;
        }
        if(!IDLoThoi){
            alert("Vui lòng chọn Lò thổi"); return;
        }

        const payload = {
            NgaySanXuat: NgayNhan,
            IdLoThoi: IDLoThoi,
            Ca: IDCaNhan,
            MeThoi: MeThoi,
            TrangThaiAT: TrangThaiAT
        };
        if(TuNgay && DenNgay){
            payload.TuNgay = TuNgay;
            payload.DenNgay = DenNgay;
        }
        $.ajax({
            url: '/BM_GangThoi_Thep/LoadDanhSachThungThepHRC1AT',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                RenderTableThungThepHRC1AT(res.data);
            },
            error: function (err) {
                alert("Lỗi khi tìm kiếm dữ liệu");
            }
        });
    }

    function RenderTableThungThepHRC1AT(data){
        const $tbody = $('#IDtbThungThepHRC1AT tbody');
        if (!$tbody.length) return;

        // cleanup
        $tbody.empty();

        if (!Array.isArray(data) || data.length === 0) {
            $tbody.append(`<tr><td colspan="7" class="text-center text-muted" style="padding:20px;font-size:20px;font-weight:600;">Không tìm thấy dữ liệu</td></tr>`);
            return;
        }

        if (!Array.isArray(data) || data.length === 0) {
            $tbody.append(`
                <tr>
                    <td colspan="9" class="text-center text-muted"
                        style="padding:20px;font-size:20px;font-weight:600;">
                        Không tìm thấy dữ liệu
                    </td>
                </tr>
            `);
            return;
        }
        // const currentLo = $("IDLoThoi").val();
        data.forEach(item => {

            const goc = item.thungGoc;
            const chuyen = item.thungChuyen;
            const isLocked = goc.isUsed === true;
            const lockAttr = isLocked ? 'disabled' : 'readonly';
            const lockClass = isLocked ? '' : 'readonly-light';

            const isChild = !!goc.parentID;

            const textClass = goc.isNM === false ? 'text-danger' : '';
            const canEdit = !goc.isNM && !goc.isUsed && !item.chaDaChuyen;
            const meTach = !chuyen && !!goc.parentID;

            const hideCheckBox = meTach || goc.isChuyenMe || goc.klGang < 0;
            const tinhTrangHtml = isLocked ? renderStatusCard(6) : '';
            const canDelete = canEdit && !(chuyen?.isChuyenDen === true || goc?.isChuyenMe === true);

            
            const html = `
            <tr class="${isChild ? 'child-row' : ''} ${isLocked ? 'row-locked' : ''}"
                data-id="${goc.id}"
                data-parent-id="${goc.parentID}"
                data-selected-id="${goc.iD_MeThoi ?? ''}"
                data-selected-ma="${goc.meThoi ?? ''}"
                data-lydo="${goc.lyDo ?? ''}"
                data-is-chuyen-me="${!!goc.isChuyenMe}"
                data-id-tulo="${chuyen?.tuLoID}"
                data-is-me-tach="${meTach}"
                data-is-me-chuyen="${!!chuyen}"
                data-is-chuyen-den="${chuyen ? chuyen.isChuyenDen : ''}"
            >
                <td>
                    ${hideCheckBox ? '':`<input type="checkbox" class="cbx-mapping" ${isLocked ? 'disabled' : ''}/>`}
                </td>
                <td class="hide-col">${formatDate_ddMMyyyy(goc.ngayTao)}</td>
                <td class="${textClass}" style="font-weight:600">
                    ${goc.meThoi ?? ''}
                </td>

                <td>
                    <input type="time"
                            class="form-control form-control-sm txt-thoiDiemRot ${textClass}"
                            value="${goc.thoiDiemRot ?? ''}"
                            ${lockAttr}>
                </td>

                <td>
                    <input type="number"
                            class="form-control form-control-sm txt-soThung ${textClass}"
                            value="${goc.soThung && goc.soThung !== '0' ? goc.soThung : ''}"
                            ${lockAttr}>
                </td>

                <td>
                    <input type="number"
                            class="form-control form-control-sm txt-klThungVaGang ${textClass}"
                            value="${goc.klThungVaGang ?? ''}"
                            ${lockAttr}>
                </td>

                <td>
                    <input type="number"
                            class="form-control form-control-sm txt-klThung ${textClass}"
                            value="${goc.klThung ?? ''}"
                            ${lockAttr}>
                </td>

                <td>
                    <input type="number"
                            class="form-control form-control-sm txt-klGang ${textClass}"
                            value="${goc.klGang ?? ''}"
                            ${lockAttr}>
                </td>

                <td>
                    <input type="text"
                            class="form-control form-control-sm txt-lyDo ${textClass}"
                            value="${goc.lyDo ?? ''}"
                            ${lockAttr}>
                </td>
                <td class="hide-col">
                    ${
                        chuyen
                            ? chuyen.isChuyenDen
                                ? `Từ lò ${chuyen.tuLoID} - ${chuyen.meCha?.meThoi ?? ''}`
                                : `Đến lò ${chuyen.tuLoID} - ${chuyen.meCha?.meThoi ?? ''}`
                            : ''
                    }
                </td>
                    ${isLocked || goc.klGang < 0 ? `<td style="display: flex;align-items: center;justify-content: center;">${tinhTrangHtml}</td>`
                    : `<td>
                        <button class="btn btn-sm btn-warning btn-edit-row"
                                style="display:${canEdit && !goc.isChuyenMe ? 'inline-block' : 'none'}">
                            <i class="bi bi-pencil-square"></i>
                        </button>

                        ${!item.daTachMe && !chuyen ? `
                            <button class="btn btn-sm btn-info btn-split-row" title="Tách mẻ">
                                <i class="bi bi-diagram-3"></i>
                            </button>
                        ` : ''}
                        ${goc.isChuyenMe !== true && goc.parentID && !chuyen?.tuMeID ? `
                            <button class="btn btn-sm btn-primary btn-chuyen-me" title="Chuyển mẻ">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>
                        ` : ''}


                        ${goc.isChuyenMe === true ? `
                            <button class="btn btn-sm btn-danger btn-thu-hoi-me" title="Thu hồi mẻ">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
