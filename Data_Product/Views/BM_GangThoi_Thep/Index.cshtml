        function updateTongKLGangNhan(maThungTG) {
          const $rows = $('#IDtbXuLySoLieu tbody tr');

          // Lấy các hàng thuộc đúng TTG GỐC (không phải copy)
          // Lưu ý: ttgKey của gốc = MaThungTG, còn copy = MaThungTG_Copy
          const $rowsBase = $rows
            .filter(`[data-mathungtg="${maThungTG}"]`)
            .filter(function () {
              const isCopy = String($(this).data('copy')) === 'true';
              const ttgKey = ($(this).data('ttgkey') ?? '').toString();
              // Chỉ nhận hàng không copy và (nếu có ttgKey) thì ttgKey phải đúng MaThungTG
              return !isCopy && (ttgKey === '' || ttgKey === maThungTG);
            });

          // Nếu không có hàng TTG gốc -> không tính/gán (tránh gán cho bản copy)
          if ($rowsBase.length === 0) return;

          // Tính tổng KLGangLong trong TTG gốc
          let tong = 0;
          $rowsBase.each(function () {
            const val = parseFloat($(this).find('.KLGangLong').text());
            if (!Number.isNaN(val)) tong += val;
          });

