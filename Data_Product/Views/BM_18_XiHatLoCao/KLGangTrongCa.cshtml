````markdown name=Views/BM_18_XiHatLoCao/KLGangTrongCa.cshtml
@{
    ViewData["Title"] = "Lọc và hiển thị KLGangTrongCa";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Lấy dữ liệu từ ViewBag do controller KLGangTrongCa trả về
    var tongTheoMe = ViewBag.TongKL_TheoMe as Dictionary<string, decimal>;
    var klDucTheoMe = ViewBag.KLDuc_TheoMe as Dictionary<string, decimal>;
    decimal klGangTong = ViewBag.TongKLGang != null ? (decimal)ViewBag.TongKLGang : 0m;
    

    // Đọc lại giá trị query từ HttpContext để bind vào input
    string qCa = Convert.ToString(ViewContext.HttpContext.Request.Query["ca"]);
    string qIdKip = Convert.ToString(ViewContext.HttpContext.Request.Query["idKip"]);
    string qNgay = Convert.ToString(ViewContext.HttpContext.Request.Query["ngayLuyenGang"]);
    string qIdLoCao = Convert.ToString(ViewContext.HttpContext.Request.Query["idLoCao"]);
}

<div class="container mt-3">
    <h3 class="mb-3">Lọc và hiển thị KLGangTrongCa theo mẻ</h3>

    <!-- Khu vực nhập tham số để lọc -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="/BM_18_XiHatLoCao/KLGangTrongCa">
                <div class="row g-3">
                    <div class="col-6 col-md-2">
                        <label class="form-label">Ca</label>
                        <input type="number" class="form-control" name="ca" value="@qCa" placeholder="VD: 1" required />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label">ID Kíp</label>
                        <input type="number" class="form-control" name="idKip" value="@qIdKip" placeholder="VD: 1" required />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">Ngày luyện gang</label>
                        <input type="date" class="form-control" name="ngayLuyenGang" value="@qNgay" required />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">ID Lò cao</label>
                        <input type="number" class="form-control" name="idLoCao" value="@qIdLoCao" placeholder="VD: 1" required />
                    </div>
                    <div class="col-12 col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            Lọc dữ liệu
                        </button>
                    </div>
                </div>
            </form>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-warning mt-3">@ViewBag.Message</div>
            }

            @if (ViewBag.FilterInfo != null)
            {
                <div class="small text-muted mt-2">
                    Bộ lọc: Ca=@ViewBag.FilterInfo.ca, Kíp=@ViewBag.FilterInfo.idKip, Ngày=@ViewBag.FilterInfo.ngay, Lò cao=@ViewBag.FilterInfo.idLoCao, Số thùng=@ViewBag.FilterInfo.count
                </div>
            }
        </div>
    </div>

    <!-- Bảng: Tổng KL theo mẻ -->
    <div class="card mb-4">
        <div class="card-header">
            Tổng khối lượng theo mẻ (TongKL_TheoMe)
        </div>
        <div class="card-body p-0">
            @if (tongTheoMe != null && tongTheoMe.Count > 0)
            {
                <table class="table table-sm table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 160px;">Số mẻ</th>
                            <th class="text-end">Tổng KL</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kv in tongTheoMe.OrderBy(k => k.Key))
                        {
                            <tr>
                                <td>@kv.Key</td>
                                <td class="text-end">@kv.Value.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-3 text-muted">Không có dữ liệu tổng khối lượng theo mẻ. Hãy nhập tham số và bấm "Lọc dữ liệu".</div>
            }
        </div>
    </div>

    <!-- Bảng: KL đúc theo mẻ -->
    <div class="card mb-4">
        <div class="card-header">
            Khối lượng đúc theo mẻ (KLDuc_TheoMe)
        </div>
        <div class="card-body p-0">
            @if (klDucTheoMe != null && klDucTheoMe.Count > 0)
            {
                <table class="table table-sm table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 160px;">Số mẻ</th>
                            <th class="text-end">KL Đúc</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kv in klDucTheoMe.OrderBy(k => k.Key))
                        {
                            <tr>
                                <td>@kv.Key</td>
                                <td class="text-end">@kv.Value.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-3 text-muted">Không có dữ liệu KL đúc theo mẻ. Hãy nhập tham số và bấm "Lọc dữ liệu".</div>
            }
        </div>
    </div>

    <!-- Bảng: Đối chiếu gộp theo số mẻ -->
    <div class="card mb-4">
        <div class="card-header">
            Đối chiếu theo Số mẻ (Tổng KL & KL Đúc)
        </div>
        <div class="card-body p-0">
            @{
                var keys = new HashSet<string>();
                if (tongTheoMe != null) foreach (var k in tongTheoMe.Keys) keys.Add(k);
                if (klDucTheoMe != null) foreach (var k in klDucTheoMe.Keys) keys.Add(k);
            }
            @if (keys.Count > 0)
            {
                <table class="table table-sm table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 160px;">Số mẻ</th>
                            <th class="text-end">Tổng KL</th>
                            <th class="text-end">KL Đúc</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var key in keys.OrderBy(k => k))
                        {
                            var tong = (tongTheoMe != null && tongTheoMe.ContainsKey(key)) ? tongTheoMe[key] : 0m;
                            var duc = (klDucTheoMe != null && klDucTheoMe.ContainsKey(key)) ? klDucTheoMe[key] : 0m;
                            <tr>
                                <td>@key</td>
                                <td class="text-end">@tong.ToString("N2")</td>
                                <td class="text-end">@duc.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-3 text-muted">Chưa có dữ liệu để đối chiếu.</div>
            }
        </div>
        <tr class="table-light fw-bold">
            <td>Tổng</td>
           
            <td class="text-end">@klGangTong.ToString("N2")</td>
        </tr>

    </div>
</div>
````