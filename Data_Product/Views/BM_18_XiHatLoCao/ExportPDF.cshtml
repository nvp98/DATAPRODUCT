@using Data_Product.Models
@using Data_Product.DTO.BM_18_DTO
@using System.Security.Claims
@inject Data_Product.Repositorys.DataContext _context
@model BM18DetailViewModel

@{
    ViewData["Title"] = "Biên bản giao nhận xỉ hạt lò cao BM.18";
    Layout = "~/Views/Shared/PrintView.cshtml";

    var phieu = Model.Phieu;
    var chiTietList = Model.ChiTiet;

    // Lấy thông tin Đại diện giao/nhận (nếu có trong phiếu)
    Tbl_TaiKhoan giao = phieu.ID_NguoiGiao.HasValue ? _context.Tbl_TaiKhoan.FirstOrDefault(x => x.ID_TaiKhoan == phieu.ID_NguoiGiao.Value) : null;
    Tbl_TaiKhoan nhan = phieu.ID_NguoiNhan.HasValue ? _context.Tbl_TaiKhoan.FirstOrDefault(x => x.ID_TaiKhoan == phieu.ID_NguoiNhan.Value) : null;

    // Lấy đơn vị/phòng ban (nếu cần)
    var phongBanGiao = giao?.ID_PhongBan != null ? _context.Tbl_PhongBan.FirstOrDefault(x => x.ID_PhongBan == giao.ID_PhongBan) : null;
    var phongBanNhan = nhan?.ID_PhongBan != null ? _context.Tbl_PhongBan.FirstOrDefault(x => x.ID_PhongBan == nhan.ID_PhongBan) : null;
    var viTriGiao = giao?.ID_ChucVu != null ? _context.Tbl_ViTri.FirstOrDefault(x => x.ID_ViTri == giao.ID_ChucVu) : null;
    var viTriNhan = nhan?.ID_ChucVu != null ? _context.Tbl_ViTri.FirstOrDefault(x => x.ID_ViTri == nhan.ID_ChucVu) : null;

    // Hiển thị khối ký nếu trạng thái phiếu == 1
    bool daKy = phieu.ID_TrangThaiBG == 1 && phieu.ID_TrangThaiBN == 1;
    string chuKyGiao = giao?.ChuKy != null ? "https://report.hoaphatdungquat.vn" + giao.ChuKy : "https://report.hoaphatdungquat.vn/img/logoHP.png";
    string chuKyNhan = nhan?.ChuKy != null ? "https://report.hoaphatdungquat.vn" + nhan.ChuKy : "https://report.hoaphatdungquat.vn/img/logoHP.png";
}

<div style="padding:0px 30px 0px 50px">
    <div style="display:flex; justify-content:space-between; margin-bottom:0;">
        <div style="flex: 1; font-weight:bold; font-size:1rem; text-transform:uppercase;">
            <img alt="Hòa Phát Dung Quất" src="https://report.hoaphatdungquat.vn/img/logoHP.png" width="205" />
            <div style="margin-top:0; font-weight:bold">CÔNG TY CỔ PHẦN THÉP</div>
            <div style="font-weight:bold; margin-left:10px">HÒA PHÁT DUNG QUẤT</div>
        </div>
        <div style="text-align:right; font-weight:bold;">
            <span>BM.18/QT.05.09</span>
            <div style="margin-top:0;"><span style="font-style:italic;">Ngày hiệu lực:</span> 01/06/2023</div>
        </div>
    </div>
    <div style="text-align:center; margin-top:0; font-size:1.5rem; font-weight:bold; text-transform:uppercase;">
        BIÊN BẢN GIAO NHẬN XỈ HẠT LÒ CAO
    </div>
    <div class="text-muted small pt-0" style="text-align:center; margin-top:0; font-style:italic;">
        Kíp @(Model.ChiTiet.FirstOrDefault()?.CaKip) Ngày
        @phieu.NgaySanXuat.ToString("dd") tháng @phieu.NgaySanXuat.ToString("MM") năm
        @phieu.NgaySanXuat.ToString("yyyy")
    </div>
    <div class="col-md-12 float-left">Chúng tôi gồm:</div>
    <div class="col-md-12 float-left" style="margin:8px 0; display:flex; width:100%">
        <div style="width:37%">1. Đại diện bên giao: Ông/bà: @giao?.HoVaTen</div>
        <div style="width:38%">Chức vụ: @viTriGiao?.TenViTri</div>
       @*  <div style="width:25%">@phongBanGiao?.TenPhongBan</div> *@
        <div style="width:25%">NM.LG</div>
    </div>
    <div class="col-md-12 float-left" style="margin:8px 0; display:flex; width:100%">
        <div style="width:37%">2. Đại diện bên nhận: Ông/bà: @nhan?.HoVaTen</div>
        <div style="width:38%">Chức vụ: @viTriNhan?.TenViTri</div>
       @*  <div style="width:25%">@phongBanNhan?.TenPhongBan</div> *@
        <div style="width:25%">NM.NL</div>
    </div>
    <div class="col-md-12 float-left" style="margin-bottom:8px;">
        Cùng nhau thống nhất lập "Biên bản giao nhận xỉ hạt lò cao" như sau:
    </div>
    <div class="card-body" style="padding-top:1%;">
        <div class="table-responsive">
            <table style="border-collapse:collapse; width:100%;" cellpadding="0">
                <thead>
                    <!-- Hàng tiêu đề 1 -->
                    <tr>
                        <th style="border:1px solid #000; padding:6px;" rowspan="2">STT</th>
                        <th style="border:1px solid #000; padding:6px;" rowspan="2">Tên nguyên/ nhiên/ phụ liệu</th>
                        <th style="border:1px solid #000; padding:6px;" rowspan="2">ĐVT</th>
                        <th style="border:1px solid #000; padding:6px;" rowspan="2">Lô</th>
                        <th style="border:1px solid #000; padding:6px;" rowspan="2">
                            Hệ số quy đổi<br>(xuất lượng xỉ)
                        </th>

                        <!-- Nhóm 4 cột -->
                        <th style="border:1px solid #000; padding:6px; text-align:center;" colspan="4">
                            Khối lượng vào/ ra trong kíp
                        </th>

                        <th style="border:1px solid #000; padding:6px;" rowspan="2">Ghi chú</th>
                    </tr>

                    <!-- Hàng tiêu đề 2 -->
                    <tr>
                        <th style="border:1px solid #000; padding:6px; text-align:center;">KL gang giao</th>
                        <th style="border:1px solid #000; padding:6px; text-align:center;">KL xỉ giao</th>
                        <th style="border:1px solid #000; padding:6px; text-align:center;">KL gang nhận</th>
                        <th style="border:1px solid #000; padding:6px; text-align:center;">KL xỉ nhận</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int stt = 1;
                        foreach (var item in chiTietList)
                        {
                            <tr>
                                <td style="border:1px solid #000; padding:6px; text-align:center;">@stt</td>
                                <td style="border:1px solid #000; padding:6px;">@item.Ten_NVL</td>
                                <td style="border:1px solid #000; padding:6px; text-align:center;">@item.DVT</td>
                                <td style="border:1px solid #000; padding:6px; text-align:center;">@item.TenMaLo</td>
                                <td style="border:1px solid #000; padding:6px; text-align:center;">@item.HeSo</td>

                                <td style="border:1px solid #000; padding:6px; text-align:right;">@item.KL_Gang_Giao</td>
                                <td style="border:1px solid #000; padding:6px; text-align:right;">@item.KL_Xi_Giao</td>
                                <td style="border:1px solid #000; padding:6px; text-align:right;">@item.KL_Gang_Nhan</td>
                                <td style="border:1px solid #000; padding:6px; text-align:right;">@item.KL_Xi_Nhan</td>

                                <td style="border:1px solid #000; padding:6px;">@item.GhiChu</td>
                            </tr>
                            stt++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <u class="col-md-12 float-left" style="padding-top:1%; font-weight:bold; font-style:italic;">Ghi chú:</u>
    <div class="col-md-12 float-left">
        <span style="font-style:italic; padding-left:16px;">
            - Khối lượng giao nhận được xác định thông qua hệ số quy đổi (P.CN, NM.LG và NM.NL đã thống nhất).
        </span>
    </div>

    @if (daKy)
    {
        <div class="col-lg-12" style="text-align: left; height: 150px; display: flex;">
            <div class="col-xxl-6 col-md-6" style="width: 50%; font-weight:bold; font-size:20px">
                <div style="text-align: center; padding-top:8px;">
                    NM.NL
                </div>
                <div style="text-align: center; padding:2%;">
                    <img src="@chuKyNhan" alt="" height="50" />
                </div>
                <div style="text-align: center; margin-top:8px">
                    @nhan?.HoVaTen
                </div>
            </div>
            <div class="col-xxl-6 col-md-6" style="width: 50%; font-weight:bold; font-size:20px">
                <div style="text-align: center; padding-top:8px;">
                    NM.LG
                </div>
                <div style="text-align: center; padding:2%;">
                    <img src="@chuKyGiao" alt="" height="50" />
                </div>
                <div style="text-align: center; margin-top:8px">
                    @giao?.HoVaTen
                </div>
            </div>
        </div>
    }
</div>