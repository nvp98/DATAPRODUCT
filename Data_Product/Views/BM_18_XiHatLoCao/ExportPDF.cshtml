						<th rowspan="2" style="border:1px solid #000; padding:6px;">Lô</th>
						<th rowspan="2" style="border:1px solid #000; padding:6px;">Hệ số quy đổi<br>(xuất lượng xỉ)</th>
						<th colspan="2" style="border:1px solid #000; padding:6px;">KL bên giao</th>
						<th colspan="2" style="border:1px solid #000; padding:6px;">KL bên nhận</th>
						<th rowspan="2" style="border:1px solid #000; padding:6px;">Ghi chú</th>
					</tr>
					<tr>
						<th style="border:1px solid #000; padding:6px;">KL gang</th>
						<th style="border:1px solid #000; padding:6px;">KL xỉ</th>
						<th style="border:1px solid #000; padding:6px;">KL gang</th>
						<th style="border:1px solid #000; padding:6px;">KL xỉ</th>
				</thead>
				<tbody>
					@* @{
                        int stt = 1;
                    }
                    @foreach (var item in ListCTBBGN)
                    {
                        <tr>
                            <td style="border:1px solid #000; padding:6px; text-align:center;">@stt</td>
                            <td style="border:1px solid #000; padding:6px;">@item.TenVatTu</td>
                            <td style="border:1px solid #000; padding:6px; text-align:center;">@item.DonViTinh</td>
                            <td style="border:1px solid #000; padding:6px; text-align:center;">@item.MaLo</td>

                            <td style="border:1px solid #000; padding:6px; text-align:center;">@item.HeSoQuyDoi</td>

                            <td style="border:1px solid #000; padding:6px; text-align:right;">@item.KL_Gang_BG.ToString("F3")</td>
                            <td style="border:1px solid #000; padding:6px; text-align:right;">@item.KL_Xi_BG.ToString("F3")</td>

                            <td style="border:1px solid #000; padding:6px; text-align:right;">@item.KL_Gang_BN.ToString("F3")</td>
                            <td style="border:1px solid #000; padding:6px; text-align:right;">@item.KL_Xi_BN.ToString("F3")</td>

                            <td style="border:1px solid #000; padding:6px;">@item.GhiChu</td>
                        </tr>
                        stt++;
                    } *@
				</tbody>

			</table>
		</div>

	</div>
	<u class="col-md-12 float-left" style="padding-top:1%;font-weight:bold;font-style:italic;">
		Ghi chú:
	</u>
	<div class="col-md-12 float-left">
		<span style="font-style:italic;padding-left:16px">- Khối lượng giao nhận được xác định thông qua hệ số quy đổi (P.CN, NM.LG và NM.NL đã thống nhất).</span>

	</div>

	@* @if (ID_BBGN.ID_TrangThai_BBGN == 1) *@
	{
	<div class="col-lg-12" style="text-align: left;height: 150px;display: flex;">
		<div class="col-xxl-6 col-md-6" style="width: 50%;font-weight:bold;font-size:20px">

			<div style="text-align: center;  padding-top:8px;">
				NM.NL
			</div>

		</div>
		<div class="col-xxl-6 col-md-6" style="width: 50%;font-weight:bold;font-size:20px">

			<div style="text-align: center; padding-top:8px;">
				NM.LG
			</div>
		</div>

	</div>

	<!-- End Recent Sales -->
	}

</div>
