		function saveFilterTime() {
			localStorage.setItem('filterFromTime', $('#filterFromTime').val());
			localStorage.setItem('filterToTime', $('#filterToTime').val());
		}

		$('#filterFromTime, #filterToTime').on('change', saveFilterTime);

		$(document).ready(function () {
			var from = localStorage.getItem('filterFromTime');
			var to = localStorage.getItem('filterToTime');

			if (from) $('#filterFromTime').val(from);
			if (to) $('#filterToTime').val(to);
		});

