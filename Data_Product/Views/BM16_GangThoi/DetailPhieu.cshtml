		}

		// ============================================
		// XỬ LÝ KHI CHỌN "KHÁC" - XÓA SỐ MẺ TRONG DATABASE
		// ============================================
		$(document).on('change', '#tableLeft .ip-some', function() {
			var $select = $(this);
			var selectedValue = $select.val();
			var $row = $select.closest('tr');

			// Nếu chọn "Khác" (id = "0")
			if (selectedValue === "0" || selectedValue === 0) {
				var canRayId = parseInt($row.data('crid'), 10);
				var idLoCao = parseInt($row.data('idlocao'), 10);
				var originalSoMe = $row.data('original-some') || $row.attr('data-original-some');

				// Chỉ thực hiện nếu có số mẻ cũ cần xóa
				if (originalSoMe && canRayId && idLoCao) {
					// Hiển thị confirm
					if (confirm('Bạn có chắc muốn xóa số mẻ "' + originalSoMe + '" khỏi dòng này?')) {
						// Gọi API để xóa số mẻ trong database
						$.ajax({
							url: '/BM16_GangThoi/ClearSoMe',
							method: 'POST',
							contentType: 'application/json; charset=utf-8',
							data: JSON.stringify({
								CanRayId: canRayId,
								ID_LoCao: idLoCao
							}),
							success: function(response) {
								console.log('Đã xóa số mẻ:', originalSoMe);

								// Highlight dòng đã xóa
								$row.find('td').addClass('cell-changed');

								// Xóa data-original-some để đánh dấu đã clear
								$row.removeAttr('data-original-some');
								$row.data('original-some', '');

								// Hiển thị thông báo nhỏ
								$row.find('.ip-some').after(
									'<small class="text-success ms-1">Đã xóa</small>'
								);

								setTimeout(function() {
									$row.find('small.text-success').fadeOut(function() {
										$(this).remove();
									});
									$row.find('td').removeClass('cell-changed');
								}, 2000);
							},
							error: function(xhr) {
								alert('Lỗi khi xóa số mẻ: ' + (xhr.responseText || 'Không xác định'));
								// Khôi phục lại giá trị cũ nếu lỗi
								if (originalSoMe) {
									var hasOpt = $select.find('option[value="' + originalSoMe + '"]').length > 0;
									if (!hasOpt) {
										var opt = new Option(originalSoMe, originalSoMe, true, true);
										$select.append(opt);
									}
									$select.val(originalSoMe).trigger('change.select2');
								}
							}
						});
					} else {
						// User hủy, khôi phục lại giá trị cũ
						if (originalSoMe) {
							var hasOpt = $select.find('option[value="' + originalSoMe + '"]').length > 0;
							if (!hasOpt) {
								var opt = new Option(originalSoMe, originalSoMe, true, true);
								$select.append(opt);
							}
							$select.val(originalSoMe).trigger('change.select2');
						}
					}
				} else {
					// Nếu chưa có số mẻ cũ, chỉ cần highlight
					$row.find('td').addClass('cell-changed');
					console.log('Dòng chưa có số mẻ, không cần xóa database');
					setTimeout(function() {
						$row.find('td').removeClass('cell-changed');
					}, 2000);
				}
			} else if (selectedValue) {
				// Nếu chọn số mẻ khác (không phải "Khác"), xóa highlight
				$row.find('td').removeClass('cell-changed');
			}
		});

		// ============================================
		// RENDER BẢNG TRÁI
		// ============================================
		function renderLeft(list) {
			var $tb = $("#tableLeft tbody");
			$tb.empty();

			if (!list || !list.length) {
				$tb.append(
					'<tr class="table-secondary text-center">' +
					'<td colspan="8" class="small">Không có dữ liệu cân ray.</td>' +
					'</tr>'
				);
				$("#leftCount").text("0 dòng");
				return;
			}

			list.forEach(function (x) {
				var san     = (x.sanRaGang != null) ? x.sanRaGang : (x.san != null ? x.san : '');
				var gioIso  = x.gioChotGang;
				var gioStr  = x.gioStr || '';
				var thungSo = x.thungSo != null ? x.thungSo : '';
				var idLo    = x.iD_LoCao;
				var canRayId = x.canRayId || null;
				var bfNo   = x.bF_no || idLo || null;

				// Lấy số mẻ hiện tại
				var someVal = (x.bkmis_SoMe || x.bkmiS_SoMe || x.soMe || x.SoMe || '').toString();
				var originalSoMe = someVal || '';

				var tr = '' +
					'<tr data-row="left"' +
					'    data-rowid="' + esc(x.rowId) + '"' +
					'    data-idlocao="' + esc(idLo) + '"' +
					'    data-crid="' + esc(canRayId) + '"' +
					'    data-bfno="' + esc(bfNo) + '"' +
					'    data-original-some="' + esc(originalSoMe) + '"' +
					'    data-san="' + esc(san) + '"' +
					'    data-gioiso="' + esc(gioIso) + '"' +
					'    data-thungso="' + esc(thungSo) + '">' +
					'  <td>' + esc(san) + '</td>' +
					'  <td>' + esc(thungSo) + '</td>' +
					'  <td>' + esc(gioStr) + '</td>' +
					'  <td class="kl-bi">' + (x.kL_Bi   != null ? x.kL_Bi   : '') + '</td>' +
					'  <td class="kl-tong">' + (x.kL_Tong != null ? x.kL_Tong : '') + '</td>' +
					'  <td class="kl-gang">' + (x.kL_Gang != null ? x.kL_Gang : '') + '</td>' +
					'  <td><select class="form-select form-select-sm ip-some"></select></td>' +
					'  <td><input name="GhiChu" class="form-control form-control-sm" value="' + esc(x.ghiChu || '') + '" /></td>' +
					'</tr>';

				$tb.append(tr);
				var $sel = $tb.find('tr:last .ip-some');

				// Prefill số mẻ hiện tại nếu có
				if (bm16SoMeSet && someVal && bm16SoMeSet.has(someVal)) {
					var opt = new Option(someVal, someVal, true, true);
					$sel.append(opt);
					$sel.val(someVal);
				}

				initSoMeSelectAjax($sel);

				if (!bm16SoMeSet) {
					checkAndPrefillSoMe($sel, someVal);
				}
			});

			$("#leftCount").text(list.length + " dòng");
		}

		function renderBoth(list) {
			renderLeft(list);
		}

		// ============================================
		// FETCH AUTO - LẤY DỮ LIỆU CÂN RAY
		// ============================================
		function fetchAuto() {
			var fromDateStr = $('#filterFromTime').val();
			var toDateStr   = $('#filterToTime').val();
			var idLoCao     = parseInt($('#IDLoCaoNum').val() || $('#ID_Locao').val());

			if (!fromDateStr || !toDateStr || !idLoCao) {
				alert('Nhập đủ Từ giờ, Đến giờ');
				return;
			}

			$("#tableLeft tbody").html('<tr><td colspan="8" class="text-center text-muted">Đang tải...</td></tr>');

			$.ajax({
				url: '/BM16_GangThoi/GetAutoSourceData',
				method: 'GET',
				data: {
					fromDateStr: fromDateStr,
					toDateStr: toDateStr,
					idLoCao: idLoCao
				},
				success: function (res) {
					console.log('[AutoSourceData] rows=', Array.isArray(res) ? res.length : 0, 'sample=', Array.isArray(res) ? res.slice(0, 5) : res);

					// Trước khi render, lấy danh sách BM16 một lần để prefill ngay
					fetchBm16SoMeList(function(){
						renderBoth(res || []);
					});
				},
				error: function (xhr) {
					alert('Lỗi tải dữ liệu auto: ' + (xhr.responseText || 'Không xác định'));
				}
			});
		}

		// ============================================
		// COLLECT FROM LEFT - GOM DỮ LIỆU TỪ BẢNG
		// ============================================
		function collectFromLeft() {
			var maPhieu = $('#PhieuID').val();
			var items = [];
			var isValid = true;
			$("#tableLeft tbody tr[data-row='left']").each(function () {
				var $r = $(this);
				var soMe = $r.find('.ip-some').val();

				// Bỏ qua dòng chọn "Khác" (đã xử lý realtime rồi)
				if (soMe === "0" || soMe === 0) {
					return;
				}

				// Bỏ qua dòng chưa chọn Số mẻ
				if (!soMe) return;

				var idLoCao = parseInt($r.data('idlocao'), 10);
				var canRayId = parseInt($r.data('crid'), 10) || null;
				var gioChot = $r.data('gioiso');
				var thungSo = $r.data('thungso');

				var klBi   = parseFloat($r.find('td.kl-bi').text()) || null;
				var klTong = parseFloat($r.find('td.kl-tong').text()) || null;
				var klGang = parseFloat($r.find('td.kl-gang').text()) || null;

				var ghiChu = $r.find('input[name="GhiChu"]').val() || null;

				items.push({
					MaPhieu: maPhieu,
					SoMe: soMe,
					ID_LoCao: idLoCao,
					CanRayId: canRayId,
					GioChotGang: gioChot,
					G_KLXeVaThung: klBi,
					G_KLXeThungVaGang: klTong,
					G_KLGangLong: klGang,
					G_GhiChu: ghiChu
				});
			});

			if (!isValid) return null;
			return items;
		}

		// ============================================
		// APPLY LEFT - LƯU DỮ LIỆU
		// ============================================
		function applyLeft() {
			var items = collectFromLeft();

			if (!items || items.length === 0) {
				alert('Không có dữ liệu để cập nhật. Vui lòng chọn Số mẻ cho các dòng.');
				return;
			}

			$.ajax({
				url: '/BM16_GangThoi/SaveAutoMapping',
				method: 'POST',
				contentType: 'application/json; charset=utf-8',
				data: JSON.stringify(items),
				success: function (res) {
					alert(res && res.message ? res.message : 'Đã cập nhật khối lượng theo Số mẻ.');
					// Refresh lại dữ liệu sau khi lưu
					fetchAuto();
				},
				error: function (xhr) {
					var msg = xhr.responseText || 'Lỗi không xác định khi lưu mapping.';
					alert('Lỗi lưu mapping auto: ' + msg);
				}
			});
		}
		$(document).on('click', '#btnAddRow', function(e) {
			e.preventDefault();

			// Tùy vào ID_LoCao quyết định cấu hình các input (đơn giản hóa: nhập hết trường có thể)
			var newRow = `
				<tr data-row="new">
					<td><input class="form-control form-control-sm ip-san"  /></td>
					<td><input class="form-control form-control-sm ip-thungso" type="number" /></td>
					<td><input class="form-control form-control-sm ip-gio" type="datetime-local" /></td>
					<td><input class="form-control form-control-sm ip-klbi" type="number" step="0.01" /></td>
					<td><input class="form-control form-control-sm ip-kltong" type="number" step="0.01" /></td>
					<td><input class="form-control form-control-sm ip-klgang" type="number" step="0.01" /></td>
					<td><input class="form-control form-control-sm ip-some" /></td>
					<td><input class="form-control form-control-sm ip-ghichu" /></td>
					<td>
						<button class="btn btn-sm btn-success btn-save-row" title="Lưu"><i class="bi bi-check2"></i></button>
						<button class="btn btn-sm btn-danger btn-cancel-row" title="Hủy"><i class="bi bi-x"></i></button>
					</td>
				</tr>
			`;

			$("#tableLeft tbody").prepend(newRow);
		});
			// Tự động tính khối lượng gang khi nhập KL bì hoặc KL tổng (dòng thêm mới)
		$(document).on('input', '.ip-klbi, .ip-kltong', function () {
			var $row = $(this).closest('tr');
			var klbi = parseFloat($row.find('.ip-klbi').val()) || 0;
			var kltong = parseFloat($row.find('.ip-kltong').val()) || 0;
			var klgang = kltong - klbi;
			$row.find('.ip-klgang').val(klgang >= 0 ? klgang.toFixed(2) : '');
		});
			// Khi lưu dòng mới
		$(document).on('click', '.btn-save-row', function () {
			var $row = $(this).closest('tr');
			var ghiChu = $row.find('.ip-ghichu').val();
			var klBi = $row.find('.ip-klbi').val();
			var klTong = $row.find('.ip-kltong').val();
			var klGang = $row.find('.ip-klgang').val();

			var hasCan = klBi || klTong || klGang;

			if (hasCan && $.trim(ghiChu) === '') {
				alert('Bạn phải nhập ghi chú nếu có nhập số cân!');
				$row.find('.ip-ghichu').addClass('is-invalid').focus();
				setTimeout(() => $row.find('.ip-ghichu').removeClass('is-invalid'), 3000);
				return;
			}
			var data = {
				// mapping tên trường theo bảng, tuỳ lò cao sẽ thay đổi phía server
				SanRaGang: parseInt($row.find('.ip-san').val()) || null,
				ThungSo: $row.find('.ip-thungso').val(),
				Gio: $row.find('.ip-gio').val(),
				KL_Bi: $row.find('.ip-klbi').val(),
				KL_Tong: $row.find('.ip-kltong').val(),
				KL_Gang: $row.find('.ip-klgang').val(),
				BKMIS_SoMe: $row.find('.ip-some').val(),
				GhiChu: $row.find('.ip-ghichu').val(),
				ID_LoCao: parseInt($('#IDLoCaoNum').val() || $('#ID_Locao').val()),    // LG1
				BF_no: parseInt($('#IDLoCaoNum').val() || $('#ID_Locao').val()),      // LG2
			};

			// Tùy theo lò cao sẽ gọi API tương ứng!
			if (data.ID_LoCao >= 1 && data.ID_LoCao <= 4) {
				// Gọi API LG1
				$.ajax({
					url: '/BM16_GangThoi/AddCanRayLG1',
					method: 'POST',
					contentType: 'application/json',
					data: JSON.stringify(data),
					success: function (res) {
						alert(res && res.message ? res.message : 'Đã thêm mới.');
						fetchAuto(); // làm mới dữ liệu bảng
					},
					error: function (xhr) {
						alert('Lỗi thêm mới: ' + (xhr.responseText || 'Không rõ'));
					}
				});
			} else if (data.BF_no == 5 || data.BF_no == 6) {
				// Gọi API LG2
				$.ajax({
					url: '/BM16_GangThoi/AddCanRayLG2',
					method: 'POST',
					contentType: 'application/json',
					data: JSON.stringify(data),
					success: function (res) {
						alert(res && res.message ? res.message : 'Đã thêm mới.');
						fetchAuto();
					},
					error: function (xhr) {
						alert('Lỗi thêm mới: ' + (xhr.responseText || 'Không rõ'));
					}
				});
			} else {
				alert('ID Lò Cao không hợp lệ!');
			}
		});

	// Hủy dòng mới
	$(document).on('click', '.btn-cancel-row', function () {
		$(this).closest('tr').remove();
	});

		// ============================================
		// BIND EVENTS
		// ============================================
		$(document).on('click', '#btnFetchAuto', function (e) {
			e.preventDefault();
			fetchAuto();
		});

		$(document).on('click', '#btnApplyLeft', function (e) {
			e.preventDefault();
			applyLeft();
		});

		// ============================================
		// ON READY - UPDATE COUNTS
		// ============================================
		$(function () {
			$("#leftCount").text($("#tableLeft tbody tr[data-row='left']").length + " dòng");
		});
	})();
</script>
