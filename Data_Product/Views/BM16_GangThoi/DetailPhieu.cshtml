		$(document).ready(function () {
			  function postDongBoBkMis($btn) {
				const maPhieu = $('#PhieuID').val()?.trim();
				const ngayStr = $('#ID_Day').val();
				// Ưu tiên hidden ID số; fallback sang ô hiện có nếu đã là số
				const idLoCao = parseInt($('#IDLoCaoNum').val() || $('#ID_Locao').val());
				const idKip   = $('#ID_Kip').val(); // đã là ID thật
				const idCa    = parseInt($('#IDCaNum').val() || $('#IDCa').val());
				//const token   = $('input[name="__RequestVerificationToken"]').val();

				if (!maPhieu || !ngayStr || !idLoCao || !idKip || !idCa) {
				  alert('Thiếu dữ liệu để đồng bộ (mã phiếu / ngày / lò cao / kíp / ca).');
				  return;
				}
				if (!confirm('Làm mới cho phiếu này?')) return;

				const originalHtml = $btn.html();
				$btn.prop('disabled', true).html('<i class="bi bi-arrow-clockwise"></i> Đang đồng bộ...');

				$.ajax({
				  url: '/BM16_GangThoi/DongBoBkMis',
				  type: 'POST',
				  data: {
					maPhieu: maPhieu,
					ngayStr: ngayStr,
					idLoCao: idLoCao,
					idKip:   idKip,
					idCa:    idCa
					//__RequestVerificationToken: token
