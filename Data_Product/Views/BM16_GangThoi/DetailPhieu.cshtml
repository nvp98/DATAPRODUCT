										<th rowspan="2" class="sticky-col so-me">Số mẻ</th>
										<th rowspan="2" class="sticky-col thung-so">Thùng số</th>
										<th rowspan="2" class="sticky-col gio">Giờ</th>
										<th rowspan="2" class="sticky-col phan-loai">Phân loại TC04</th>
