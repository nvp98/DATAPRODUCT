<script>
		// Thay thế phần JavaScript cũ

	(function() {
		const escapeHtml = (str) => $('<div/>').text(str || '').html();

		const getFormParams = () => ({
			maPhieu: $('#PhieuID').val(),
			ngayStr: $('#ID_Day').val(),
			idLoCao: $('#IDLoCaoNum').val(),
			idCa: $('#IDCaNum').val()
		});

		const showNotification = ($row, message, duration = 2000) => {
			$row.find('td').addClass('cell-changed');
			$row.find('.ip-some').after(`<small class="text-success ms-1">${message}</small>`);

			setTimeout(() => {
				$row.find('small.text-success').fadeOut(function() {
					$(this).remove();
				});
				$row.find('td').removeClass('cell-changed');
			}, duration);
		};

		const initSoMeSelectAjax = ($select) => {
			if ($select.data('init') === 'true') return;

			$select.select2({
				width: '100%',
				placeholder: 'Chọn Số mẻ',
				allowClear: true,
				dropdownParent: $('#doubleAutoCollapse'),
				ajax: {
					url: '/BM16_GangThoi/GetAllSoMe',
					delay: 300,
					data: params => ({
						...getFormParams(),
						term: params.term,
						take: 100,
						select2: true
					}),
					processResults: data => {
						data.push({ id: "0", text: "Khác" });
						return { results: data };
					}
				}
			});

			$select.data('init', 'true');
		};

		const updateSoMeToZero = ($row, maPhieu, idLoCao, canRayId, successMessage) => {
			const payload = [{
				MaPhieu: maPhieu,
				SoMe: "0",
				ID_LoCao: idLoCao,
				CanRayId: canRayId,
				GioChotGang: $row.data('gioiso'),
				G_KLXeVaThung: parseFloat($row.find('td.kl-bi').text()) || null,
				G_KLXeThungVaGang: parseFloat($row.find('td.kl-tong').text()) || null,
				G_KLGangLong: parseFloat($row.find('td.kl-gang').text()) || null,
				G_GhiChu: $row.find('input[name="GhiChu"]').val() || null
			}];

			$.ajax({
				url: '/BM16_GangThoi/SaveAutoMapping',
				method: 'POST',
				contentType: 'application/json; charset=utf-8',
				data: JSON.stringify(payload),
				success: () => {
					$row.removeAttr('data-original-some').data('original-some', '');
					showNotification($row, successMessage);
				},
				error: xhr => {
					alert('Lỗi khi cập nhật số mẻ = 0: ' + (xhr.responseText || 'Không xác định'));
					console.error('Lỗi cập nhật:', xhr);
				}
			});
		};

		const rollbackSelect = ($select, originalValue) => {
			if (originalValue) {
				const hasOpt = $select.find(`option[value="${originalValue}"]`).length > 0;
				if (!hasOpt) {
					const opt = new Option(originalValue, originalValue, true, true);
					$select.append(opt);
				}
				$select.val(originalValue).trigger('change.select2');
			} else {
				$select.val('').trigger('change.select2');
			}
		};

		$(document).on('change', '#tableLeft .ip-some', function() {
			const $select = $(this);
			const selectedValue = $select.val();
			const $row = $select.closest('tr');

			if (selectedValue === "0" || selectedValue === 0) {
				const canRayId = parseInt($row.data('crid'), 10);
				const idLoCao = parseInt($row.data('idlocao'), 10);
				const originalSoMe = $row.data('original-some') || $row.attr('data-original-some');
				const maPhieu = $('#PhieuID').val();

				if (originalSoMe && originalSoMe !== "0" && canRayId && idLoCao) {
					if (confirm(`Bạn có chắc muốn xóa số mẻ "${originalSoMe}" và cập nhật giá trị 0?`)) {
						$.ajax({
							url: '/BM16_GangThoi/ClearSoMe',
							method: 'POST',
							contentType: 'application/json; charset=utf-8',
							data: JSON.stringify({ CanRayId: canRayId, ID_LoCao: idLoCao }),
							success: () => {
								console.log('Đã xóa số mẻ:', originalSoMe);
								updateSoMeToZero($row, maPhieu, idLoCao, canRayId, 'Đã xóa & cập nhật số mẻ = 0');
							},
							error: xhr => {
								alert('Lỗi khi xóa số mẻ: ' + (xhr.responseText || 'Không xác định'));
								rollbackSelect($select, originalSoMe);
							}
						});
					} else {
						rollbackSelect($select, originalSoMe);
					}
				} else if (canRayId && idLoCao) {
					if (confirm('Bạn có chắc muốn cập nhật số mẻ = 0 cho dòng này?')) {
						updateSoMeToZero($row, maPhieu, idLoCao, canRayId, 'Đã cập nhật số mẻ = 0');
					} else {
						$select.val('').trigger('change.select2');
					}
				} else {
					$row.find('td').addClass('cell-changed');
					console.log('Dòng thiếu thông tin canRayId hoặc idLoCao');
					setTimeout(() => $row.find('td').removeClass('cell-changed'), 2000);
				}
			} else if (selectedValue) {
				$row.find('td').removeClass('cell-changed');
			}
		});

		const renderLeft = (list) => {
			const $tbody = $("#tableLeft tbody");
			$tbody.empty();

			if (!list || !list.length) {
				$tbody.append(
					'<tr class="table-secondary text-center">' +
					'<td colspan="9" class="small">Không có dữ liệu cân ray.</td></tr>'
				);
				$("#leftCount").text("0 dòng");
				return;
			}

			list.forEach(x => {
				const san = x.sanRaGang ?? x.san ?? '';
				const gioIso = x.gioChotGang;
				const gioStr = x.gioStr || '';
				const thungSo = x.thungSo ?? '';
				const idLo = x.iD_LoCao;
				const canRayId = x.canRayId || null;
				const bfNo = x.bF_no || idLo || null;

				const rawSoMe = x.bkmis_SoMe ?? x.bkmiS_SoMe ?? x.soMe ?? x.SoMe;
				const someVal = (rawSoMe === 0 || rawSoMe === "0") ? "0" : (rawSoMe ? rawSoMe.toString() : '');
				const originalSoMe = someVal;

				// ✅ Lấy trạng thái khóa từ API (không còn check bm16SoMeSet)
				const isLocked = x.isLocked === true;

				const hasGhiChu = x.ghiChu && x.ghiChu.trim() !== '';
				const numberStyle = hasGhiChu ? 'style="color: red; font-weight: bold;"' : '';
				const gioChotGangStr = x.gioChotGang
					? (() => {
						const d = new Date(x.gioChotGang);
						const day = String(d.getDate()).padStart(2, '0');
						const month = String(d.getMonth() + 1).padStart(2, '0');
						const year = d.getFullYear();
						return `${day}-${month}-${year}`;
					})()
					: '';

				const tr = `
					<tr data-row="left"
						data-rowid="${escapeHtml(x.rowId)}"
						data-idlocao="${escapeHtml(idLo)}"
						data-crid="${escapeHtml(canRayId)}"
						data-bfno="${escapeHtml(bfNo)}"
						data-original-some="${escapeHtml(originalSoMe)}"
						data-san="${escapeHtml(san)}"
						data-gioiso="${escapeHtml(gioIso)}"
						data-thungso="${escapeHtml(thungSo)}">

						<td ${numberStyle}>${escapeHtml(gioChotGangStr)}</td>
						<td>${escapeHtml(san)}</td>
						<td>${escapeHtml(thungSo)}</td>
						<td ${numberStyle}>${escapeHtml(gioStr)}</td>
						<td class="kl-bi" ${numberStyle}>${x.kL_Bi ?? ''}</td>
						<td class="kl-tong" ${numberStyle}>${x.kL_Tong ?? ''}</td>
						<td class="kl-gang" ${numberStyle}>${x.kL_Gang ?? ''}</td>
						<td><select class="form-select form-select-sm ip-some"></select></td>
						<td><input name="GhiChu" class="form-control form-control-sm" value="${escapeHtml(x.ghiChu || '')}" disabled/></td>
					</tr>
				`;

				$tbody.append(tr);
				const $select = $tbody.find('tr:last .ip-some');

				// ✅ Prefill số mẻ hiện tại
				if (someVal !== '') {
					const optionText = someVal === "0" ? "Khác" :
									   isLocked ? `${someVal} (Đã chốt)` : someVal;
					$select.append(new Option(optionText, someVal, true, true));
				}

				// ✅ Khóa hoặc khởi tạo Select2 dựa trên IsLocked từ API
				if (isLocked) {
					$select.prop('disabled', true);
					$select.css({
						'background-color': '#e9ecef',
						'cursor': 'not-allowed',
						'color': '#6c757d'
					});
					$select.attr('title', 'Số mẻ này đã được chốt (G_ID_TrangThai = 3), không thể thay đổi');
				} else {
					initSoMeSelectAjax($select);
				}
			});

			$("#leftCount").text(`${list.length} dòng`);
		};

		const fetchAuto = () => {
			const fromDateStr = $('#filterFromTime').val();
			const toDateStr = $('#filterToTime').val();
			const idLoCao = parseInt($('#IDLoCaoNum').val() || $('#ID_Locao').val());
			const maPhieu = $('#PhieuID').val();

			if (!fromDateStr || !toDateStr || !idLoCao) {
				alert('Nhập đủ Từ giờ, Đến giờ');
				return;
			}

			$("#tableLeft tbody").html(
				'<tr><td colspan="9" class="text-center text-muted">Đang tải...</td></tr>'
			);

			$.ajax({
				url: '/BM16_GangThoi/GetAutoSourceData',
				method: 'GET',
				data: { fromDateStr, toDateStr, idLoCao, maPhieu }, // Truyền thêm maPhieu
				success: res => {
					console.log('[AutoSourceData] rows=', Array.isArray(res) ? res.length : 0);
					renderLeft(res || []);
				},
				error: xhr => {
					alert('Lỗi tải dữ liệu auto: ' + (xhr.responseText || 'Không xác định'));
				}
			});
		};

		const collectFromLeft = () => {
			const maPhieu = $('#PhieuID').val();
			const items = [];

			$("#tableLeft tbody tr[data-row='left']").each(function() {
				const $row = $(this);
				const soMe = $row.find('.ip-some').val();

				if (!soMe || soMe === "0") return;

				items.push({
					MaPhieu: maPhieu,
					SoMe: soMe,
					ID_LoCao: parseInt($row.data('idlocao'), 10),
					CanRayId: parseInt($row.data('crid'), 10) || null,
					GioChotGang: $row.data('gioiso'),
					G_KLXeVaThung: parseFloat($row.find('td.kl-bi').text()) || null,
					G_KLXeThungVaGang: parseFloat($row.find('td.kl-tong').text()) || null,
					G_KLGangLong: parseFloat($row.find('td.kl-gang').text()) || null,
					G_GhiChu: $row.find('input[name="GhiChu"]').val() || null
				});
			});

			return items;
		};

		const applyLeft = () => {
			const items = collectFromLeft();

			if (!items || items.length === 0) {
				alert('Không có dữ liệu để cập nhật. Vui lòng chọn Số mẻ cho các dòng.');
				return;
			}

			$.ajax({
				url: '/BM16_GangThoi/SaveAutoMapping',
				method: 'POST',
				contentType: 'application/json; charset=utf-8',
				data: JSON.stringify(items),
				success: res => {
					alert(res?.message || 'Đã cập nhật khối lượng theo Số mẻ.');
					location.reload();
				},
				error: xhr => {
					alert('Lỗi lưu mapping auto: ' + (xhr.responseText || 'Không xác định'));
				}
			});
		};

		$(document).on('click', '#btnAddRow', function(e) {
			e.preventDefault();
			const newRow = `
				<tr data-row="new">
					<td></td>
					<td><input class="form-control form-control-sm ip-san" type="number"/></td>
					<td><input class="form-control form-control-sm ip-thungso" type="number"/></td>
					<td><input class="form-control form-control-sm ip-gio" type="datetime-local"/></td>
					<td><input class="form-control form-control-sm ip-klbi" type="number" step="0.01"/></td>
					<td><input class="form-control form-control-sm ip-kltong" type="number" step="0.01"/></td>
					<td><input class="form-control form-control-sm ip-klgang" type="number" step="0.01"/></td>
					<td><input class="form-control form-control-sm ip-some"/></td>
					<td><input class="form-control form-control-sm ip-ghichu"/></td>
					<td>
						<button class="btn btn-sm btn-success btn-save-row" title="Lưu">
							<i class="bi bi-check2"></i>
						</button>
						<button class="btn btn-sm btn-danger btn-cancel-row" title="Hủy">
							<i class="bi bi-x"></i>
						</button>
					</td>
				</tr>
			`;
			$("#tableLeft tbody").prepend(newRow);
		});

		$(document).on('input', '.ip-klbi, .ip-kltong', function() {
			const $row = $(this).closest('tr');
			const klBi = parseFloat($row.find('.ip-klbi').val()) || 0;
			const klTong = parseFloat($row.find('.ip-kltong').val()) || 0;
			const klGang = klTong - klBi;
			$row.find('.ip-klgang').val(klGang >= 0 ? klGang.toFixed(2) : '');
		});

		$(document).on('click', '.btn-save-row', function() {
			const $row = $(this).closest('tr');
			const ghiChu = $row.find('.ip-ghichu').val();
			const klBi = $row.find('.ip-klbi').val();
			const klTong = $row.find('.ip-kltong').val();
			const klGang = $row.find('.ip-klgang').val();
			const hasCan = klBi || klTong || klGang;

			if (hasCan && $.trim(ghiChu) === '') {
				alert('Bạn phải nhập ghi chú nếu có nhập số cân!');
				$row.find('.ip-ghichu').addClass('is-invalid').focus();
				setTimeout(() => $row.find('.ip-ghichu').removeClass('is-invalid'), 3000);
				return;
			}

			const idLoCao = parseInt($('#IDLoCaoNum').val() || $('#ID_Locao').val());
			const data = {
				SanRaGang: parseInt($row.find('.ip-san').val()) || null,
				ThungSo: $row.find('.ip-thungso').val(),
				Gio: $row.find('.ip-gio').val(),
				KL_Bi: klBi,
				KL_Tong: klTong,
				KL_Gang: klGang,
				BKMIS_SoMe: $row.find('.ip-some').val(),
				GhiChu: ghiChu,
				ID_LoCao: idLoCao,
				BF_no: idLoCao
			};

			const apiUrl = (idLoCao >= 1 && idLoCao <= 4)
				? '/BM16_GangThoi/AddCanRayLG1'
				: (idLoCao === 5 || idLoCao === 6)
					? '/BM16_GangThoi/AddCanRayLG2'
					: null;

			if (!apiUrl) {
				alert('ID Lò Cao không hợp lệ!');
				return;
			}

			$.ajax({
				url: apiUrl,
				method: 'POST',
				contentType: 'application/json',
				data: JSON.stringify(data),
				success: res => {
					alert(res?.message || 'Đã thêm mới.');
					fetchAuto();
				},
				error: xhr => {
					alert('Lỗi thêm mới: ' + (xhr.responseText || 'Không rõ'));
				}
			});
		});

		$(document).on('click', '.btn-cancel-row', function() {
			$(this).closest('tr').remove();
		});

		$(document).on('click', '#btnFetchAuto', e => {
			e.preventDefault();
			fetchAuto();
		});

		$(document).on('click', '#btnApplyLeft', e => {
			e.preventDefault();
			applyLeft();
		});

		$(() => {
			$("#leftCount").text($("#tableLeft tbody tr[data-row='left']").length + " dòng");
		});

	})();
</script>
