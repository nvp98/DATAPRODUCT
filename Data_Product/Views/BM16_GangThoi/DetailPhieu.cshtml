<script>
	(function () {
		function esc(s) {
			return $('<div/>').text(s || '').html();
		}
		var bm16SoMeSet = null;

		function fetchBm16SoMeList(done) {
			var params = {
				maPhieu: $('#PhieuID').val(),
				ngayStr: $('#ID_Day').val(),
				idLoCao: $('#IDLoCaoNum').val(),
				idCa: $('#IDCaNum').val(),
				term: '',
				take: 500,
				select2: true
			};
			$.get('/BM16_GangThoi/GetAllSoMe', params)
				.done(function (data) {
					if (Array.isArray(data)) {
						bm16SoMeSet = new Set(data.map(function (d) { return d.id; }));
						console.log('[BM16 GetAllSoMe] count=', data.length, 'sample=', data.slice(0, 5));
					}
					if (typeof done === 'function') done();
				})
				.fail(function () {
					bm16SoMeSet = null;
					if (typeof done === 'function') done();
				});
		}

		// ============================================
		// KIỂM TRA VÀ PREFILL SỐ MẺ
		// ============================================
		function checkAndPrefillSoMe($sel, someVal) {
			if (!someVal) return;
			var params = {
				maPhieu: $('#PhieuID').val(),
				ngayStr: $('#ID_Day').val(),
				idLoCao: $('#IDLoCaoNum').val(),
				idCa: $('#IDCaNum').val(),
				term: '',
				take: 500,
				select2: true
			};
			$.ajax({
				url: '/BM16_GangThoi/GetAllSoMe',
				method: 'GET',
				data: params,
				success: function (data) {
					if (!Array.isArray(data)) return;
					var found = data.find(function (d) { return (d.id || '') === someVal; });
					if (found) {
						var hasOpt = $sel.find('option').filter(function(){
							return $(this).val() === found.id;
						}).length > 0;
						if (!hasOpt) {
							var opt = new Option(found.text || found.id, found.id, true, true);
							$sel.append(opt);
						}
						$sel.val(found.id).trigger('change');
					}
				}
			});
		}

		// ============================================
		// INIT SELECT2 CHO SỐ MẺ (AJAX)
		// ============================================
		function initSoMeSelectAjax($sel) {
			if ($sel.data('init') === 'true') return;

			$sel.select2({
				width: '100%',
				placeholder: 'Chọn Số mẻ',
				allowClear: true,
				dropdownParent: $('#doubleAutoCollapse'),
				ajax: {
					url: '/BM16_GangThoi/GetAllSoMe',
					delay: 300,
					data: function (params) {
						return {
							maPhieu: $('#PhieuID').val(),
							ngayStr: $('#ID_Day').val(),
							idLoCao: $('#IDLoCaoNum').val(),
							idCa: $('#IDCaNum').val(),
							term: params.term,
							take: 100,
							select2: true
						};
					},
					processResults: function (data) {
						// THÊM "Khác" vào cuối danh sách
						data.push({
							id: "0",
							text: "Khác"
						});
						return { results: data };
