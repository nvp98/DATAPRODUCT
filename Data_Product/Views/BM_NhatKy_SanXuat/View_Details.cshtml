<script>
    function requestDelete(phieuId) {
        if (confirm("Bạn có chắc chắn muốn gửi yêu cầu xóa phiếu này không?")) {
            $.ajax({
                url: '/BM_NhatKy_SanXuat/DeleteRequest', // Đường dẫn đến action xử lý
                type: 'POST',
                data: { id: phieuId },
                success: function (result) {
                    alert("Đã gửi yêu cầu xóa thành công.");
                    // Có thể reload trang hoặc ẩn nút đi
                    location.reload();
                },
                error: function () {
                    alert("Có lỗi xảy ra khi gửi yêu cầu xóa.");
                }
            });
        }
    }
    function requestHieuChinh(phieuId) {

        if (confirm("Bạn có chắc chắn muốn gửi yêu cầu hiệu chỉnh phiếu này không?")) {
            window.location.href = '@Url.Action("Edit", "BM_NhatKy_SanXuat")' + '?IDNKSX=' + phieuId + '&isHieuChinh=1';
        }
    }

     function requestThuHoi(phieuId) {

        if (confirm("Bạn có chắc chắn muốn thu hồi phiếu này không?")) {
                $.ajax({
                url: '/BM_NhatKy_SanXuat/ThuHoiPhieu',
                type: 'POST',
                // contentType: 'application/json',
                data: { IDPhieus: phieuId },
                success: function (res) {
                    alert(res.message);
                    window.location.href = "/BM_NhatKy_SanXuat/Index"; // redirect sang trang Index
                },
                error: function (err) {
                    alert("Có lỗi xảy ra: " + err.responseText);
                }
            });
            // window.location.href = '@Url.Action("Edit", "BM_NhatKy_SanXuat")' + '?IDNKSX=' + phieuId + '&isHieuChinh=1';
        }
    }
     // Reset Phiếu
    $("#btnReset").click(function () {
        var selected = $(this).data("id");

        if (selected.length === 0) {
            alert("Vui lòng chọn ít nhất 1 phiếu!");
            return;
        }
         // Thêm confirm
        if (!confirm("Bạn có chắc muốn reset phiếu này?")) {
            return; // nếu bấm Cancel thì thoát luôn
        }
        $.ajax({
            url: '/BM_NhatKy_SanXuat/ResetPhieu',
            type: 'POST',
            // contentType: 'application/json',
            data: { IDPhieus: selected },
            success: function (res) {
                alert(res.message);
                window.location.href = "/BM_NhatKy_SanXuat/Index"; // redirect sang trang Index
            },
            error: function (err) {
                alert("Có lỗi xảy ra: " + err.responseText);
            }
        });
    });


</script>