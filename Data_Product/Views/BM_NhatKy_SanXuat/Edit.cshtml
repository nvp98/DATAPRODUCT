                        <div class="card-body p-2" style="">
                           
                           
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label class="mb-1 font-weight-bold text-left">
                                        Tải lên dữ liệu  <a href="/BM/template_NhatKy_SanXuat.xlsx" class="" download>
                                            <small>Tải biểu mẫu nhập liệu</small>
                                        </a>
                                    </label>
                                    <div class="row col-md-12">
                                        <input type="file" id="fileInput" accept=".xlsx, .xls" />
                                    </div>

                                    <div id="tableContainer" class="col-md-12">
                                        <table id="excelTable" border="1"></table>
                                    </div>
                                </div>
                                <script>
                                    document.getElementById("fileInput").addEventListener("change", function (event) {
                                        let file = event.target.files[0]; // Lấy file đã chọn
                                        let reader = new FileReader();

                                        reader.onload = function (e) {
                                            let data = new Uint8Array(e.target.result);
                                            let workbook = XLSX.read(data, { type: "array" });
                                            let sheet = workbook.Sheets[workbook.SheetNames[0]]; // Lấy sheet đầu tiên
                                            let jsonData = XLSX.utils.sheet_to_json(sheet, { header: 1 }); // Chuyển thành JSON

                                            let tableBody = document.querySelector("#dataTable tbody");
                                            document.querySelectorAll("#dataTable tbody tr").forEach(row => {
                                                //row.style.display = "none"; // Ẩn dòng
                                                //row.querySelectorAll("input, select").forEach(el => {
                                                //    el.removeAttribute("required");
                                                //    el.value = "";
                                                //}); // Xóa required tránh lỗi khi submit
                                                row.remove(); // Xóa hẳn dòng khỏi DOM
                                            });
                                            const Xuong = @Html.Raw(Json.Serialize(ViewBag.IDXuong));
                                            const CumThietBi = @Html.Raw(Json.Serialize(ViewBag.CumThietBi))
                                            console.log(jsonData);
                                            jsonData.forEach((row, indexx) => {
                                                if (indexx < 7) return; // Bỏ qua tiêu đề (nếu có)

                                                let TenXuong = row[1];
                                                let TenCumTB = row[2];
                                                let timeValueDung = row[3];
                                                let timeValueChay = row[4];
                                                let formattedTimeDung = excelTimeToHHMM(timeValueDung);
                                                let formattedTimeChay = excelTimeToHHMM(timeValueChay);
                                                let TGianDung = Math.round(Number(row[5] || 0));
                                                let NoidungDung = row[6];
                                                let soLanSC = row[7];
                                                let TGianChoXL = row[8];
                                                let TGianXL = row[9];
                                                let TGianSC = row[10];
                                                let SuCoCN = (row[11] || "").trim();
                                                let ChoCN = (row[12] || "").trim();
                                                let KhachQuan = (row[13] || "").trim();
                                                let ChoKhac = (row[14] || "").trim();
                                                let DungBTBD = (row[15] || "").trim();
                                                let TGianKH_BTBD = row[16];
                                                let DungDayChuyen = row[17];
                                                let GhiChu = (row[18] || "").trim();

                                                let cumObj = CumThietBi.find(x => x.text.trim() === TenCumTB);
                                                let cumValue = cumObj ? cumObj.value : "";

                                                //index 0->n
                                                let index = indexx - 7;

                                                console.log(TGianDung)

                                                let newRow = `
                                                <tr class="data-row">
                                                    <!-- Xưởng -->
                                                    <td>
                                                        <select class="form-control marginTB5 LoCao" name="NhatKy_SanXuat_ChiTiet[${index}].ID_Xuong" required>
                                                            ${Xuong.map(opt => `<option value="${opt.value}">${opt.text}</option>`).join("")}
                                                        </select>
                                                    </td>

                                                    <!-- Cụm thiết bị -->
                                                    <td>
                                                        <select class="form-control marginTB5" name="NhatKy_SanXuat_ChiTiet[${index}].ID_CumTB" required>
                                                            ${CumThietBi.map(opt =>
                                                                `<option value="${opt.value}" ${opt.value == cumValue ? "selected" : ""}>${opt.text}</option>`
                                                            ).join("")}
                                                        </select>
                                                    </td>

                                                                                       <!-- Thời điểm dừng -->
                                                    <td><input type="time" name="NhatKy_SanXuat_ChiTiet[${index}].ThoiDiemDung" value="${formattedTimeDung}" class="form-control ThoiDiemDung" required></td>

                                                    <!-- Thời điểm chạy lại -->
                                                    <td><input type="time" name="NhatKy_SanXuat_ChiTiet[${index}].ThoiDiemChay" value="${formattedTimeChay}" class="form-control ThoiDiemChay" required></td>

                                                       <!-- Thời gian dừng -->
                                                    <td><input type="number" name="NhatKy_SanXuat_ChiTiet[${index}].ThoiGianDung" value="${TGianDung}" class="form-control ThoiGianDung" min="0" step="1" readonly></td>

                                                    <!-- Nội dung dừng máy -->
                                                    <td><input type="text" name="NhatKy_SanXuat_ChiTiet[${index}].NoiDungDung" value="${NoidungDung}" class="form-control" required></td>

                                                    <!-- Thiết bị Cơ điện -->
                                                    <td><input type="number" name="NhatKy_SanXuat_ChiTiet[${index}].CoDien_SoLan" value="${soLanSC}" class="form-control text-center" min="0" step="1"></td>
                                                    <td><input type="number" name="NhatKy_SanXuat_ChiTiet[${index}].CoDien_ChoXL" value="${TGianChoXL}" class="form-control text-center CoDien_ChoXL" min="0" step="0.1"></td>
                                                    <td><input type="number" name="NhatKy_SanXuat_ChiTiet[${index}].CoDien_TGianXL" value="${TGianXL}" class="form-control text-center CoDien_TGianXL" min="0" step="0.1"></td>
                                                    <td><input type="number" name="NhatKy_SanXuat_ChiTiet[${index}].CoDien_TGianSC" value="${TGianSC}" class="form-control text-center CoDien_TGianSC" min="0" step="0.1" readonly></td>

                                                    <!-- Công nghệ -->
                                                    <td class="text-center"><input type="radio" name="NhatKy_SanXuat_ChiTiet[${index}].LyDo_DungThietBi" ${SuCoCN != "" ? "checked" : ""} value="1" class="radio-square"></td>
                                                    <td class="text-center"><input type="radio" name="NhatKy_SanXuat_ChiTiet[${index}].LyDo_DungThietBi" ${ChoCN != "" ? "checked" : ""} value="2" class="radio-square"></td>
                                                    <td class="text-center"><input type="radio" name="NhatKy_SanXuat_ChiTiet[${index}].LyDo_DungThietBi" ${KhachQuan != "" ? "checked" : ""} value="3" class="radio-square"></td>
                                                    <td class="text-center"><input type="radio" name="NhatKy_SanXuat_ChiTiet[${index}].LyDo_DungThietBi" ${ChoKhac != "" ? "checked" : ""} value="4" class="radio-square"></td>
                                                    <td class="text-center"><input type="radio" name="NhatKy_SanXuat_ChiTiet[${index}].LyDo_DungThietBi" ${DungBTBD != "" ? "checked" : ""} value="5" class="radio-square"></td>

                                                    <!-- Thời gian kế hoạch BTBD -->
                                                    <td><input type="number" name="NhatKy_SanXuat_ChiTiet[${index}].TGian_KH_BTBD" value="${TGianKH_BTBD}" class="form-control text-center" min="0" step="0.1"></td>

                                                    <!-- Gây dừng dây chuyền -->
                                                    <td>
                                                        <select class="form-control marginTB5" name="NhatKy_SanXuat_ChiTiet[${index}].DungDayChuyen" required>
                                                            <option value="true" ${DungDayChuyen.trim === "có" ? "selected" : ""}>Có</option>
                                                            <option value="false" ${DungDayChuyen.trim === "không" ? "selected" : ""}>Không</option>
                                                        </select>
                                                    </td>

                                                    <!-- Ghi chú -->
                                                    <td><input type="text" name="NhatKy_SanXuat_ChiTiet[${index}].GhiChu" value="${GhiChu}" class="form-control"></td>

                                                    <!-- Nút xóa -->
                                                    <td class="text-center"><button type="button" class="btn btn-danger removeRow"><i class="bi bi-x-lg"></i></button></td>
                                                </tr>
                                                `;


                                                $("#dataTable tbody").append(newRow);

                                                // Kiểm tra dữ liệu từ file Excel cho SoThung

                                            });

                                            // Xử lý sự kiện xóa dòng
                                            document.querySelectorAll(".removeRow").forEach((btn) => {
                                                btn.addEventListener("click", function () {
                                                    this.parentElement.parentElement.remove();
                                                });
                                            });
                                        }


                                        reader.readAsArrayBuffer(file);
                                    });
                                    // Chuyển đổi định dạng thời gian về HH:mm
                                    function excelTimeToHHMM(excelTime) {
                                        let totalMinutes = Math.round(excelTime * 24 * 60);
                                        let hours = Math.floor(totalMinutes / 60);
                                        let minutes = totalMinutes % 60;
                                        return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}`;
                                    }

                                    // Hàm formatTime không cần thiết nếu không dùng
                                    function formatTime(timeStr) {
                                        let date = new Date(timeStr);
                                        let hours = date.getHours().toString().padStart(2, '0');
                                        let minutes = date.getMinutes().toString().padStart(2, '0');
                                        return `${hours}:${minutes}`;
                                    }

                                </script>

                            </div>

                            <div class="table-responsive pb-2" style="">
                                <table class="table table-bordered table-hover" id="dataTable" cellpadding="0">
                                    <div id="warning-message" style="display: none; color: white; background-color: red; padding: 10px; position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 1000; border-radius: 5px;"></div>
                                    <thead>
                                        <tr>
                                            <th rowspan="2" style="width:150px;">Xưởng</th>
                                            <th rowspan="2" style="width:200px;">Cụm thiết bị</th>
                                            <th rowspan="2" style="width:100px;">Thời điểm dừng</th>
                                            <th rowspan="2" style="width:100px;">Thời điểm chạy lại</th>
                                            <th rowspan="2" style="width:100px;">Thời gian dừng</th>
                                            <th rowspan="2" style="width:250px;">Nội dung dừng máy</th>

                                            <!-- Nhóm 1: Thiết bị Cơ điện -->
                                            <th colspan="4" class="text-center">Thiết bị Cơ điện</th>

                                            <!-- Nhóm 2: Công nghệ -->
                                            <th colspan="2">Công nghệ</th>

                                            <!-- Các cột thời gian khác -->
                                            <th rowspan="2" style="width:100px;">TG dừng khách quan</th>
                                            <th rowspan="2" style="width:100px;">TG chờ khác</th>
                                            <th rowspan="2" style="width:100px;">TG dừng BTBD thực tế</th>
                                            <th rowspan="2" style="width:120px;">TG dừng theo KH BTBD tháng (giờ)</th>
                                            <th rowspan="2" style="width:100px;">Gây dừng dây chuyền</th>
                                            <th rowspan="2" style="width:150px;">Ghi chú</th>
                                        </tr>

                                        <tr>
                                            <th style="width:100px;">Số sự cố<br>(lần)</th>
                                            <th style="width:120px;">TG chờ xử lý SC<br>(phút)</th>
                                            <th style="width:120px;">Thời gian xử lý SC<br>(phút)</th>
                                            <th style="width:120px;">Thời gian sự cố<br>(phút)</th>

                                            <th style="width:120px;">Dừng máy do Sự cố công nghệ</th>
                                            <th style="width:120px;">Dừng máy do Chờ công nghệ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int index = 0;
                                        }
                                        @foreach(var item in Model.NhatKy_SanXuat_ChiTiet)
                                        {
                                            <tr class="data-row">
                                                <td>
                                                    <select class="form-control marginTB5 " name="NhatKy_SanXuat_ChiTiet[@index].ID_Xuong" style="width: 100%" required>
                                                        @foreach (var it in ViewBag.IDXuong)
                                                        {
                                                            if(item.ID_Xuong.ToString() == @it.Value)
                                                            {
                                                                <option value='@it.Value' selected>@it.Text</option>
                                                            }
                                                            else
                                                            {
                                                                <option value='@it.Value'>@it.Text</option>
                                                            }
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    @if (ViewBag.CumThietBi != null && ((IEnumerable<SelectListItem>)ViewBag.CumThietBi).Any())
                                                    {
                                                        <select class="form-control marginTB5 " name="NhatKy_SanXuat_ChiTiet[@index].ID_CumTB" style="width: 100%" required>
                                                            <option value='' selected>--Chọn Cụm TB--</option>
                                                            @foreach (var it in ViewBag.CumThietBi)
                                                            {
                                                                if (item.ID_CumTB.ToString() == @it.Value)
                                                                {
                                                                    <option value='@it.Value' selected>@it.Text</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value='@it.Value'>@it.Text</option>
                                                                }
                                                            }
                                                        </select>

                                                    }
                                                    else
                                                    {
                                                        <select class="form-control marginTB5 " name="NhatKy_SanXuat_ChiTiet[@index].ID_CumTB" style="width: 100%">
                                                        </select>
                                                    }
                                                </td>
