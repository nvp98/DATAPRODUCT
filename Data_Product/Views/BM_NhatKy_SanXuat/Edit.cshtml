<script>

            // Hàm check dieu kien
            function checkRequiredFields(row) {
              row = $(row); // ✅ ép kiểu DOM → jQuery object
              // Lấy giá trị số từ các input trong dòng
              const choXL = parseFloat(row.find('.CoDien_ChoXL').val()) || 0;
              const tgXL = parseFloat(row.find('.CoDien_TGianXL').val()) || 0;
              const total = choXL + tgXL;
              row.find('.CoDien_TGianSC').val(total);
              // 🔹 Nếu tổng < 1 → bắt buộc nhập lý do
              if (total < 1) {
                row.find('.LyDo_DungThietBi').attr('required', true);
              }
              else {
                row.find('.LyDo_DungThietBi').removeAttr('required');
              }

              // 🔹 Nếu có thời gian chờ xử lý → bắt buộc nhập thời gian xử lý
              if (choXL !== 0 && tgXL ===0) {
                row.find('.CoDien_TGianXL').attr('required', true);
              } else {
                row.find('.CoDien_TGianXL').removeAttr('required');
              }
            }

           document.querySelectorAll('input[type="radio"]').forEach(radio => {
              // thiết lập trạng thái ban đầu
              radio.previousChecked = radio.checked;
              radio.addEventListener('click', e => {
                if (radio.previousChecked) {
                  radio.checked = false;
                }
                document
                  .querySelectorAll('input[name="' + radio.name + '"]')
                  .forEach(r => (r.previousChecked = false));
                radio.previousChecked = radio.checked;
              });
            });
        $(document).on('input change blur', '.CoDien_ChoXL, .CoDien_TGianXL', function () {
            const row = $(this).closest('tr'); // dòng hiện tại
             @* checkRequiredFields(row); *@

          @*   const choXL = parseFloat(row.find('.CoDien_ChoXL').val()) || 0;
            const tgXL  = parseFloat(row.find('.CoDien_TGianXL').val()) || 0; *@
            // Nếu TGianXL <1 bắt buộc chọn LyDo
            @* row.find('.CoDien_TGianSC').val(choXL + tgXL); *@
            checkRequiredFields($(row));
           @*  if((choXL + tgXL) < 1){
                row.find('.LyDo_DungThietBi').attr('required', true);
            }
            else{
            row.find('.LyDo_DungThietBi').removeAttr('required'); // xóa require
            }

            // Add required nếu Chờ xử lý nhập -> xử lý phải nhập
            if(choXL != 0){
                row.find('.CoDien_TGianXL').attr('required', true);
            }
            else{
                row.find('.CoDien_TGianXL').removeAttr('required');
            } *@
           
        });
        $(document).ready(function () {
          // Duyệt qua tất cả các dòng có class hoặc tương tự
          $('#dataTable tbody tr').each(function (index, row) {
            checkRequiredFields($(row)); // Gọi hàm kiểm tra cho từng dòng
          });
        });
        $(document).on('input change blur', '.ThoiDiemChay, .ThoiDiemDung', function () {
            const row = $(this).closest('tr'); // lấy dòng hiện tại

            // ---- 1. Lấy giá trị thời điểm dừng và chạy ----
            const timeDung = row.find('.ThoiDiemDung').val();
            const timeChay = row.find('.ThoiDiemChay').val();

            // ---- 2. Nếu cả 2 đều có giá trị, tính thời gian dừng (phút) ----
            if (timeDung && timeChay) {
                const [h1, m1] = timeDung.split(':').map(Number);
                const [h2, m2] = timeChay.split(':').map(Number);
                let total1 = h1 * 60 + m1;
                let total2 = h2 * 60 + m2;

                // Nếu chạy lại sau nửa đêm → cộng thêm 24h
                if (total2 < total1) total2 += 24 * 60;

                const diff = total2 - total1;
                row.find('.ThoiGianDung').val(diff);
            } else {
                row.find('.ThoiGianDung').val('');
            }
        });

</script>
<script type="text/javascript">
    $(document).ready(function () {
        function normalizeTime(timeStr) {
            const [h, m] = timeStr.split(':').map(s => s.padStart(2, '0'));
            return `${h}:${m}`;
        }

        $('#TaoPhieu').on('submit', function (e) {
            let isValid = true; // mặc định là hợp lệ
            let selectedValueCa = $('#IDCa').val();
            const form = document.getElementById("TaoPhieu");
            const inputs = form.querySelectorAll('input[type="time"]');
           

            for (const input of inputs) {
                const value = normalizeTime(input.value);
                console.log(value)
                if (selectedValueCa == "1" && value && (value < "08:00" || value > "20:00")) {
                    isValid = false;
                    alert('Vui lòng điền đúng khoảng thời gian ca Ngày từ 08:00 - 20:00!');
                    input.focus();
                    break; // Thoát vòng lặp
                }
                else if (selectedValueCa == "2" && value && (value > "08:00" && value < "20:00")) {
                    isValid = false;
                    alert('Vui lòng điền đúng khoảng thời gian ca Đêm từ 20:00 - 08:00!');
                    input.focus();
                    break; // Thoát vòng lặp
                }
            }
            const rowCount = document.querySelectorAll('tr.data-row').length;
            if (rowCount === 0) {
                isValid = false;
                alert("Không có dòng dữ liệu nào! Vui lòng thêm ít nhất 1 dòng trước khi lưu.");
            }

            // Kiểm tra dừng theo KH BTBD
            // Lặp qua từng dòng trong bảng
            $('#dataTable tbody tr').each(function (index, row) {
               @*  const thoiGianDung = parseFloat($(row).find('.ThoiGianDung').val()) || 0;
                const thoiGianSC   = parseFloat($(row).find('.CoDien_TGianSC').val()) || 0; *@
               @*  console.log(row,thoiGianSC,"jjsjsjssjj")
                if (thoiGianSC != thoiGianDung) {
                    alert(`Dòng ${index + 1}: Thời gian sự cố (${thoiGianSC} phút) phải bằng Thời gian dừng (${thoiGianDung} phút)!`);
                    isValid = false;

                    // Đánh dấu dòng lỗi (đỏ viền)
                    $(row).css('background-color', '#ffe6e6');
                    $(row).find('.ThoiGianDung, .CoDien_TGianSC').css('border-color', 'red');

                    // focus vào ô lỗi đầu tiên
                    $(row).find('.CoDien_TGianSC').focus();
                    return false; // break vòng each
                } else {
                    // reset style nếu hợp lệ
                    $(row).css('background-color', '');
                    $(row).find('.ThoiGianDung, .CoDien_TGianSC').css('border-color', '');
                } *@
                
                const tgSCXL = parseFloat($(row).find('.CoDien_TGianSC').val()) || 0;

                if(tgSCXL >1){
                     alert(`Dòng ${index + 1}: Thời gian sự cố <= 1 phút!`);
                    isValid = false;
                     // Đánh dấu dòng lỗi (đỏ viền)
                    $(row).css('background-color', '#ffe6e6');
                    $(row).find('.CoDien_TGianSC').css('border-color', 'red');
                    return false; // break vòng each
                }

                const lydo = parseFloat($(row).find('.LyDo_DungThietBi:checked').val()) || 0;
                const TGian_KH_BTBD = parseFloat($(row).find('.TGian_KH_BTBD').val()) || 0;
                if(lydo === 5 && TGian_KH_BTBD ===0 && $(row).find('.TGian_KH_BTBD').val() ===""){
                    alert(`Dòng ${index + 1}: Vui lòng điền TG dừng theo kế hoạch!`);
                    isValid = false;

                     // Đánh dấu dòng lỗi (đỏ viền)
                    $(row).css('background-color', '#ffe6e6');
                    $(row).find('.TGian_KH_BTBD').css('border-color', 'red');
                    return false; // break vòng each
                }


            });
            if (!isValid) {
                e.preventDefault(); // Chặn submit nếu có lỗi
            }
        });
    });

</script>



<script type="text/javascript">
     // Reset Phiếu
    $("#btnReset").click(function () {
        var selected = $(this).data("id");

        if (selected.length === 0) {
            alert("Vui lòng chọn ít nhất 1 phiếu!");
            return;
        }
         // Thêm confirm
        if (!confirm("Bạn có chắc muốn reset phiếu này?")) {
            return; // nếu bấm Cancel thì thoát luôn
        }
        $.ajax({
            url: '/BM_NhatKy_SanXuat/ResetPhieu',
            type: 'POST',
            // contentType: 'application/json',
            data: { IDPhieus: selected },
            success: function (res) {
                alert(res.message);
                window.location.href = "/BM_NhatKy_SanXuat/Index"; // redirect sang trang Index
            },
            error: function (err) {
                alert("Có lỗi xảy ra: " + err.responseText);
            }
        });
    });
</script>


