@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";

    Pager pager = new Pager();
    int pageNo = 0;
    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}
<style>
    .radio-square {
        -webkit-appearance: none;
        appearance: none;
        width: 22px;
        height: 22px;
        border: 2px solid #555;
        border-radius: 4px; /* 0 cho hình vuông hoàn toàn */
        position: relative;
        cursor: pointer;
    }

        .radio-square:checked::before {
            content: "";
            position: absolute;
            top: 4px;
            left: 4px;
            width: 12px;
            height: 12px;
            background-color: #0d6efd; /* màu xanh Bootstrap */
        }
</style>

<style>
    /* Thu nhỏ tất cả ô nhập trong bảng */
    #dataTable input.form-control,
    #dataTable select.form-control {
        height: 28px !important; /* giảm chiều cao */
        padding: 2px 6px !important; /* thu nhỏ padding */
        font-size: 13px !important; /* cỡ chữ nhỏ hơn */
        line-height: 1.2;
    }

    /* Thu nhỏ radio vuông */
    #dataTable .radio-square {
        width: 18px;
        height: 18px;
    }

    /* Căn giữa text trong các cột số */
    #dataTable input[type="number"],
    #dataTable input[type="time"],
    #dataTable select {
        text-align: center;
    }

    /* Giảm khoảng cách giữa các hàng */
    #dataTable tr td {
        padding: 3px 4px !important;
    }

    /* Giảm độ rộng mặc định của các cột nhỏ (thời gian, số phút, radio) */
    #dataTable td input[type="time"],
    #dataTable td input[type="number"] {
        max-width: 90px !important;
    }

    /* Nếu có icon nút xóa nhỏ lại */
    #dataTable .btn-danger {
        padding: 2px 6px;
        font-size: 12px;
    }

    /* Select2 nếu bạn dùng */
    .select2-container .select2-selection--single {
        height: 28px !important;
        min-height: 28px !important;
        padding: 2px 6px !important;
        font-size: 13px !important;
    }

    .select2-selection__rendered {
        line-height: 24px !important;
    }

    .select2-selection__arrow {
        height: 26px !important;
    }
</style>


