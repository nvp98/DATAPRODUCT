                        tbodyGangChia.find(`tr[data-mathungthep='${maThungThep}']`).addClass('highlight-green');
                  },
                  error: function () {
                      alert("Lỗi khi nhận dữ liệu!");
                  }
              });
        }) 

        $('#tblDuLieu').on('click', '.btnDetailChiaGangCR', function() {
            const row = $(this).closest('tr');
            const idThung = row.data('id');
            const mathungtg = row.data('mathungtg');
            const isCopy = row.data('iscopy');
            const maThungThep = row.data('mathungthep');
            if(!idThung ){
                alert('lỗi không lấy được ID');
                return;
            }
            const payload = {
                idThung: idThung,
                mathungtg: mathungtg,
                isCopy: isCopy
            }
            $.ajax({
                  url: "/BM16_GangThoi_PKH/GetDetailChiaGangCR",
                  type: "POST",
                  contentType: "application/json",
                  data: JSON.stringify(payload),
                  processData: false,
                  success: function (res) {
                     renderChiaGangCR(res, maThungThep)
                  },
                  error: function () {
                      alert("Lỗi khi nhận dữ liệu!");
                  }
              });
        })

        
        function fmt(v, d=2){
          if (v == null || isNaN(v)) return '';
          return Number(v).toLocaleString('vi-VN',{minimumFractionDigits:d, maximumFractionDigits:d});
        }

        function renderChiaGangCR(resp, maThungThep) {
          const modalChiaGang = new bootstrap.Modal(document.getElementById('modalShowChiaGangCR'));
          modalChiaGang.show();

          const $tb = $('#tblChiaGangCR tbody').empty();
          const $cur = $('#cr-current').empty();

          if (!resp || !resp.listThung) return;

          // ===== 1) Tìm item đang xem detail theo maThungThep =====
          const curItem = resp.listThung.find(x => x?.thungGang?.maThungThep === maThungThep);

          if (curItem) {
            const g = curItem.thungGang || {};
            const p = curItem.phanBo || {};
            const isCopy = curItem.isCopy === true;

            // KL HRC base hiển thị: ưu tiên KLGangChia, nếu null thì lấy T_KLGangLong (nhưng nếu là TTG copy thì ẩn theo yêu cầu trước đó)
            const base = (g.klGangChia != null) ? g.klGangChia : (isCopy ? null : g.tklGangLong);
            const tile = (p.tyLeTrongMaTTG != null) ? (p.tyLeTrongMaTTG * 100).toFixed(2) + '%' : '';

            $cur.append(`
              <div>
                <span class="label">Đang xem: </span>
                <span class="cr-highlight">${g.maThungThep || ''}</span>
                ${isCopy ? `<span class="cr-highlight" style="color:#b91c1c;"> (TTG copy)</span>` : ''}
              </div>
              <div class="mt-1">
                <span class="label">KL HRC: </span><b>${base != null ? fmt(base) : ''}</b>
                &nbsp;|&nbsp; <span class="label">% trong tổng G_KLGangLong: </span><b>${tile}</b>
                &nbsp;|&nbsp; <span class="label">KL CR phân bổ: </span><b>${fmt(p.klPhanBoCR)}</b>
              </div>
            `);
          } else {
            $cur.append(`
              <div>
                <span class="label">Đang xem: </span>
                <span class="cr-highlight">${maThungThep || ''}</span>
                <span class="label"> — không tìm thấy dữ liệu khớp trong response.</span>
              </div>
            `);
          }

          // ===== 2) Render bảng chi tiết như cũ =====
          resp.listThung.forEach(item => {
            const g = item.thungGang || {};
            const p = item.phanBo || {};
            const isCopy = item.isCopy === true;

            const tr = $('<tr>').toggleClass('tr-copy', isCopy);
            tr.append(`<td>${g.maThungThep || ''}</td>`);
            tr.append(`<td>${fmt(g.klGangChia ? g.klGangChia : isCopy ? '' : g.tklGangLong)}</td>`);
            tr.append(`<td>${p.tyLeTrongMaTTG != null ? (p.tyLeTrongMaTTG * 100).toFixed(2) + '%' : ''}</td>`);
            tr.append(`<td>${fmt(p.klPhanBoCR)}</td>`);
            tr.append(`<td style="text-align:center">${isCopy ? 'TTG copy' : ''}</td>`);

            $tb.append(tr);
          });
        }



        function applyColumnVisibility() {
            const display = isHidden ? 'none' : 'table-cell';

            // Cột cần ẩn/hiện
            $('.hide-col').css('display', display);

            $('.total-space').attr('colspan', isHidden ? 11 : 14);
            $('.space-2').attr('colspan', isHidden ? 5 : 11);

            $('.space-3').attr('colspan', isHidden ? 4 : 10);
            $('.space-4').attr('colspan', isHidden ? 7 : 7);

            if(!isHidden){
                $(".sticky-col-5").css("left", "299px");
                $(".sticky-col-6").css("left", "353px");
                $(".sticky-col-7").css("left", "469px");
                $(".sticky-col-8").css("left", "538px");
            }else{
                $(".sticky-col-5").css("left", "183px");
                $(".sticky-col-6").css("left", "237px");
                $(".sticky-col-7").css("left", "353px");
                $(".sticky-col-8").css("left", "422px");
            }
        }

        $('#cbx-selectAll').on('change', function () {
            const isChecked = $(this).is(':checked');

