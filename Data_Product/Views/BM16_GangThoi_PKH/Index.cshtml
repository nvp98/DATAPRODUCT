        function checkCondition(item){
            if(item.isCopy){
                return false;
            }
            const isDUC = item.chuyenDen === "DUC1" || item.chuyenDen === "DUC2";

            if (isDUC && item.t_ID_TrangThai === 4 && item.g_ID_TrangThai === 3) {
                return true;
            }
            const hasKlGangChia = item.klGangChia != null && item.klGangChia !== '' ;

            if(hasKlGangChia && item.klGangChia <= 0){
                return false;
            }
            // Danh sách điều kiện bắt buộc phải có
            const requiredFields = [
                item.t_ID_TrangThai === 4,
                item.g_ID_TrangThai === 3,
                item.kL_XeGoong != null,
                item.g_KLThungChua != null,
                item.g_KLThungVaGang != null,
                item.g_KLGangLong != null,
                item.chuyenDen != null,
                item.gio_NM != null,
                item.iD_TTG != null,
                item.soThungTG != null,
               
            ];

            // Nếu không có klGangChia thì phải kiểm tra thêm 3 trường này
            if (!hasKlGangChia) {
                requiredFields.push(
                    item.t_KLThungVaGang != null,
                    item.t_KLThungChua != null,
                    item.t_KLGangLong != null,
                    item.klThungVaGang_Thoi != null,
                    item.klThung_Thoi != null,
                    item.klGang_Thoi != null,
                    item.kL_phe != null,
                    item.iD_MeThoi != null,
                    item.gioChonMe != null
                    
                );
            }

            return requiredFields.every(cond => cond === true);
           
        }
        
