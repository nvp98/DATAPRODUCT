        function KLChenhLech(g_KLGangLong, t_KLGangLong) {
            
            if (g_KLGangLong !== null && t_KLGangLong !== null && !isNaN(g_KLGangLong) && !isNaN(t_KLGangLong) && t_KLGangLong !== 0) {
                return parseFloat(t_KLGangLong - g_KLGangLong).toFixed(2);
            }
            return null; 
        }

        function PhanTramChenhLech(g_KLGangLong, t_KLGangLong) {
            if (g_KLGangLong !== null && t_KLGangLong !== null && !isNaN(g_KLGangLong) && !isNaN(t_KLGangLong) && t_KLGangLong !== 0) {
                const klChenh = KLChenhLech(g_KLGangLong, t_KLGangLong);

                if (klChenh !== null) {
                    const goc = parseFloat(t_KLGangLong);
                    const result = (parseFloat(klChenh) / goc) * 100;

                    if (!isNaN(result)) {
                        return result.toFixed(2); 
                    }
                }
            }
            return '0.0'; 
        }

        function tinhTongTheoMaThungGang() {
            const flatData = danhSachThung.flat();
            const grouped = {};

            flatData.forEach(item => {
                const key = item.maThungGang;
                if (!key) return;

                if (!grouped[key]) {
                    grouped[key] = {
                        maThungGang: key,
                        sum_g_KLGangLong: 0,
                        sum_t_KLGangLong: 0,
                        sum_klGangChia: 0
                    };
                }

                const g_KLGangLong = parseFloat(item.g_KLGangLong) || 0;
                const t_KLGangLong = parseFloat(item.t_KLGangLong) || 0;
                const klGangChia = parseFloat(item.klGangChia);

                if (item.t_copy === false) {
                    grouped[key].sum_g_KLGangLong += g_KLGangLong;
                }

                grouped[key].sum_t_KLGangLong += t_KLGangLong;

                if (!isNaN(klGangChia)) {
                    grouped[key].sum_klGangChia += klGangChia;
                    grouped[key].hasValid_klGangChia = true;
                } else if (!isNaN(t_KLGangLong)) {
                    grouped[key].sum_klGangChia += t_KLGangLong;
                }
            });
            // Giai đoạn sau cùng: nếu không có klGangChia hợp lệ thì reset sum_klGangChia về 0
            for (const key in grouped) {
                if (!grouped[key].hasValid_klGangChia) {
                    grouped[key].sum_klGangChia = 0;
                }
                delete grouped[key].hasValid_klGangChia; // dọn dẹp
            }

            return grouped;
        }
         // Tính phần trăm chênh lệch khối lượng
        function PhanTramKLChenhLech(maThungGang) {
            const grouped = tinhTongTheoMaThungGang();
            const record = grouped[maThungGang];
            if (!record) return null;

            const {
                sum_klGangChia,
                sum_t_KLGangLong,
                sum_g_KLGangLong
            } = record;

            const isNumber = val => val !== null && !isNaN(val);

            // Ưu tiên tính phần trăm theo klGangChia nếu có
            if (isNumber(sum_klGangChia) && sum_klGangChia !== 0 && isNumber(sum_g_KLGangLong) && sum_g_KLGangLong !== 0) {
                const result = ((sum_klGangChia - sum_g_KLGangLong) / sum_klGangChia) * 100;
                return result.toFixed(1);
            }

            // Nếu không có klGangChia → fallback sang t_KLGangLong
            if (isNumber(sum_t_KLGangLong) && sum_t_KLGangLong !== 0 && isNumber(sum_g_KLGangLong) && sum_g_KLGangLong !== 0) {
                const result = ((sum_t_KLGangLong - sum_g_KLGangLong) / sum_t_KLGangLong) * 100;
                return result.toFixed(1);
            }

            return null;
        }


        // Tính khối lượng chênh lệch
        function KhoiLuongChenhLech(maThungGang) {
            const grouped = tinhTongTheoMaThungGang();
            const record = grouped[maThungGang];

            if (!record) return null;
            const {
                sum_klGangChia,
                sum_g_KLGangLong,
                sum_t_KLGangLong
            } = record;

            const isNumber = val => val !== null && !isNaN(val);

            // Ưu tiên sử dụng klGangChia nếu có
            if (isNumber(sum_klGangChia) && sum_klGangChia !== 0 && isNumber(sum_g_KLGangLong) && sum_g_KLGangLong !== 0) {
                return (sum_klGangChia - sum_g_KLGangLong).toFixed(2);
            }

            // Nếu không có klGangChia → dùng t_KLGangLong
            if (isNumber(sum_t_KLGangLong) && sum_t_KLGangLong !== 0 && isNumber(sum_g_KLGangLong)  && sum_g_KLGangLong !== 0) {
                return (sum_t_KLGangLong - sum_g_KLGangLong).toFixed(2);
            }

            return null;
        }


        // Tính khối lượng đúc theo phần trăm
        function KhoiLuongDuc(maThungGang) {
            const percent = parseFloat($("#percentDuc").val()) || 0;
            const grouped = tinhTongTheoMaThungGang();
            const record = grouped[maThungGang];

            if (!record) return null;
            const {
                sum_klGangChia,
                sum_g_KLGangLong,
                sum_t_KLGangLong
            } = record;

            const isNum = v => typeof v === 'number' && isFinite(v);

            if (!isNum(sum_g_KLGangLong)) return null; 

            const base =
              (isNum(sum_klGangChia) && sum_klGangChia !== 0) ? sum_klGangChia :
              (isNum(sum_t_KLGangLong) && sum_t_KLGangLong !== 0) ? sum_t_KLGangLong :
              0;

            return (sum_g_KLGangLong - base) * (percent / 100);
        }

